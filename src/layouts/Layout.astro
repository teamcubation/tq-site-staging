---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, type Locale } from "../i18n/config";
import { SITE, organizationSchema } from "../lib/seo";
import { ui } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  /** Ruta relativa de la imagen OG (default: OG de marca). */
  image?: string;
  /** JSON-LD extra de la página (Service, BreadcrumbList, WebSite, etc.). */
  schema?: unknown[];
  /** Evita indexación (útil en preview/staging). */
  noindex?: boolean;
  ogType?: string;
  /** Traducciones disponibles por locale (para hreflang). Vacío = sin alternates. */
  translations?: Partial<Record<Locale, string>>;
}

const {
  title = "Teamcubation",
  description = "La experiencia no se enseña: se entrena.",
  lang = defaultLocale,
  image,
  schema = [],
  noindex = false,
  ogType = "website",
  translations,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// OG apunta al dominio donde vive el build (staging) para que la preview
// resuelva; canonical/hreflang siguen en producción (SITE.url / Astro.site).
const ogUrl = new URL(Astro.url.pathname, SITE.deployUrl).href;
// OG por idioma (og-es/en/pt). Se puede override con la prop `image`.
const ogImage = new URL(image ?? `/og/og-${lang}.png`, SITE.deployUrl).href;

const ogLocales: Record<Locale, string> = { es: "es_AR", en: "en_US", pt: "pt_BR" };

// hreflang: solo si hay traducciones declaradas (evita alternates rotos). Con barra
// final, igual que el canonical (sin ella GitHub Pages responde con un 301).
const conBarra = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const alternates = translations
  ? Object.entries(translations).map(([loc, path]) => ({
      loc,
      href: new URL(conBarra(path!), Astro.site).href,
    }))
  : [];
// x-default: la versión en español, la misma en las tres páginas del grupo.
const xDefault = alternates.find((a) => a.loc === defaultLocale)?.href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [organizationSchema, ...schema],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Redirect por idioma del browser (solo en la raíz ES). Excluye crawlers
         para que indexen todas las versiones vía hreflang; una vez por sesión. -->
    <script is:inline>
      (function () {
        if (window.location.pathname !== "/") return;
        var ua = navigator.userAgent || "";
        if (/bot|crawl|spider|slurp|mediapartners|baidu|yandex|sogou|duckduckgo|applebot|bingpreview|facebookexternalhit|ia_archiver/i.test(ua)) return;
        // Navegación interna (p.ej. elegir "ES" desde /pt o /en) = elección
        // deliberada del usuario → no auto-redirigir por idioma del sistema.
        try {
          if (document.referrer && new URL(document.referrer).origin === window.location.origin) return;
        } catch (e) {}
        if (sessionStorage.getItem("lang-redirected")) return;
        var lang = (navigator.language || "").toLowerCase();
        var target = null;
        if (lang.indexOf("en") === 0) target = "/en/";
        else if (lang.indexOf("pt") === 0) target = "/pt/";
        if (target) {
          sessionStorage.setItem("lang-redirected", "1");
          window.location.replace(target);
        }
      })();
    </script>

    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-PS65VB9');
    </script>
    <!-- End Google Tag Manager -->

    <!-- Apollo -->
    <script is:inline>
      function initApollo(){var n=Math.random().toString(36).substring(7),o=document.createElement("script");
      o.src="https://assets.apollo.io/micro/website-tracker/tracker.iife.js?nocache="+n,o.async=!0,o.defer=!0,
      o.onload=function(){window.trackingFunctions.onLoad({appId:"669817d6d1af0c01b288be3b"})},
      document.head.appendChild(o)}initApollo();
    </script>
    <!-- End Apollo -->

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload de las fuentes de marca (evita FOUT en el titular/hero) -->
    <link rel="preload" href="/fonts/funnel-display-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/darker-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.loc} href={a.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(SITE.ogImageWidth)} />
    <meta property="og:image:height" content={String(SITE.ogImageHeight)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <a class="saltar-al-contenido" href="#contenido">{ui[lang].skip}</a>
    <Header lang={lang} translations={translations} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
