---
import Layout from "../../layouts/Layout.astro";
import MetodologiaBody from "../../components/pages/MetodologiaBody.astro";
import { metodologiaContent } from "../../content/metodologia";
import { breadcrumbSchema } from "../../lib/seo";

const c = metodologiaContent.en;
const translations = { es: "/metodologia", en: "/en/methodology", pt: "/pt/metodologia" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="en"
  translations={translations}
  schema={[breadcrumbSchema([{ name: "Home", path: "/en/" }, { name: "Methodology", path: "/en/methodology" }])]}
>
  <MetodologiaBody lang="en" />
</Layout>
