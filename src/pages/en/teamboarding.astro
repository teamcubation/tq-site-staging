---
import Layout from "../../layouts/Layout.astro";
import TeamboardingBody from "../../components/pages/TeamboardingBody.astro";
import { teamboardingContent } from "../../content/teamboarding";
import { breadcrumbSchema, ids, teamboardingSchema } from "../../lib/seo";

const c = teamboardingContent.en;
const translations = { es: "/teamboarding", en: "/en/teamboarding", pt: "/pt/teamboarding" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="en"
  translations={translations}
  schema={[teamboardingSchema("en"), breadcrumbSchema([{ name: "Home", path: "/en/" }, { name: "Teamboarding", path: "/en/teamboarding" }])]}
  webPage={{ mainEntity: ids.teamboarding }}
>
  <TeamboardingBody lang="en" />
</Layout>
