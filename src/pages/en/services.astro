---
import Layout from "../../layouts/Layout.astro";
import ServiciosBody from "../../components/pages/ServiciosBody.astro";
import { serviciosContent } from "../../content/servicios";
import { serviciosEn, ORDEN } from "../../data/servicios";
import { breadcrumbSchema, itemListSchema } from "../../lib/seo";

const c = serviciosContent.en;
const translations = { es: "/servicios", en: "/en/services", pt: "/pt/servicos" };
const schema = [
  breadcrumbSchema([{ name: "Home", path: "/en/" }, { name: "Services", path: "/en/services" }]),
  itemListSchema(
    ORDEN.map((k) => ({
      nombre: serviciosEn[k].nombre,
      slug: `/en/services/${serviciosEn[k].slug.replace("/servicios/", "")}`,
    }))
  ),
];
---

<Layout title={c.seoTitle} description={c.seoDesc} lang="en" translations={translations} schema={schema}>
  <ServiciosBody lang="en" />
</Layout>
