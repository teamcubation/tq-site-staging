---
import Layout from "../../layouts/Layout.astro";
import ContactoBody from "../../components/pages/ContactoBody.astro";
import { contactoContent } from "../../content/contacto";
import { breadcrumbSchema, faqSchema } from "../../lib/seo";

const c = contactoContent.en;
const translations = { es: "/contacto", en: "/en/contact", pt: "/pt/contato" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="en"
  translations={translations}
  schema={[
    breadcrumbSchema([{ name: "Home", path: "/en/" }, { name: "Contact", path: "/en/contact" }]),
    faqSchema("/en/contact", c.faqs, "en"),
  ]}
  webPage={{ type: "ContactPage" }}
>
  <ContactoBody lang="en" />
</Layout>
