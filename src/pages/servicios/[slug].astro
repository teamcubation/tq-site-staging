---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import ProgramaBody from "../../components/pages/ProgramaBody.astro";
import { servicios, ORDEN } from "../../data/servicios";
import { serviceSchema, breadcrumbSchema } from "../../lib/seo";

export const getStaticPaths = (() => {
  return ORDEN.map((key) => {
    const svc = servicios[key];
    return {
      params: { slug: svc.slug.replace("/servicios/", "") },
      props: { svc },
    };
  });
}) satisfies GetStaticPaths;

const { svc } = Astro.props;
const slug = svc.slug.replace("/servicios/", "");
const translations = { es: svc.slug, en: `/en/services/${slug}` };
const schema = [
  serviceSchema(svc, "es"),
  breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Servicios", path: "/servicios" },
    { name: svc.nombre, path: svc.slug },
  ]),
];
---

<Layout title={svc.title} description={svc.meta} lang="es" translations={translations} schema={schema}>
  <ProgramaBody svc={svc} lang="es" />
</Layout>
