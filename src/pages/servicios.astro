---
import Layout from "../layouts/Layout.astro";
import HeroInterior from "../components/HeroInterior.astro";
import CierreCoral from "../components/CierreCoral.astro";
import { servicios, CAPAS } from "../data/servicios";
import escenaHero from "../assets/ilustraciones/escena-hero-anillo-salto.png";
---

<Layout
  title="Programas de IA para empresas y talento | Teamcubation"
  description="Compare ocho servicios según su equipo y su objetivo: adoptar IA, automatizar procesos, crear aplicaciones o desarrollar software formando talento."
>
  <main id="contenido">
    <HeroInterior
      kicker="Servicios"
      titulo={'Programas de IA y formación de talento para <span class="resaltado">su empresa.</span>'}
      bajada="Teamcubation ofrece ocho servicios para identificar oportunidades de IA, entrenar equipos de negocio, formar especialistas internos y desarrollar software mientras se forman desarrolladores. El punto de partida depende de sus necesidades y de la experiencia de sus equipos."
      imagen={escenaHero}
      imagenAlt="Figuras verdes y naranjas atravesando juntas un anillo ámbar"
      cols="1.15fr 0.85fr"
      maxImg={400}
      padBottom={64}
    />

    <section class="titulo-capas">
      <div class="contenedor">
        <h2 class="h2">¿Qué podemos lograr juntos?</h2>
      </div>
    </section>

    <section class="capas-svc">
      <div class="contenedor capas-svc__wrap">
        {CAPAS.map((capa) => (
          <article>
            <h3 class="capa-svc__titulo">{capa.titulo}</h3>
            <p class="capa-svc__bajada">
              <strong class="capa-svc__etiqueta">{capa.etiqueta}</strong> {capa.bajada}
            </p>
            <div class="scards">
              {capa.keys.map((k) => {
                const s = servicios[k];
                return (
                  <a class="scard" href={s.slug}>
                    <p class="scard__necesita">Si necesita: {s.necesita}</p>
                    <h4 class="scard__titulo">{s.nombre}</h4>
                    <p class="scard__resumen">{s.resumen}</p>
                    <p class="scard__meta">
                      Para quién: {s.publico}<br />Duración: {s.duracion}<br />Foco: {s.foco}
                    </p>
                  </a>
                );
              })}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="primer-paso">
      <div class="contenedor">
        <h2 class="h2 mb28">El primer paso depende de su punto de partida.</h2>
        <div class="dos-col">
          <div>
            <h3 class="h3">¿Su equipo todavía no usa IA?</h3>
            <p class="p">Starter AI trabaja sobre las herramientas y las tareas de cada persona para construir una base de uso cotidiano. <a class="enlace" href="/servicios/starter-ai">Empezar con Starter AI</a></p>
          </div>
          <div>
            <h3 class="h3">¿Ya usa IA y quiere automatizar procesos?</h3>
            <p class="p">Booster AI acompaña la automatización de procesos propios. Booster AI Intensivo permite conocer el método con un piloto acotado de una semana. <a class="enlace" href="/servicios/booster-ai">Ver Booster AI</a> · <a class="enlace" href="/servicios/booster-ai-intensivo">Ver el formato Intensivo</a></p>
          </div>
        </div>
      </div>
    </section>

    <section class="panel-exp-sec">
      <div class="contenedor">
        <div class="panel-exp">
          <h2 class="h2 mb16">Una forma de construir experiencia.</h2>
          <p class="p">Los programas de entrenamiento trabajan sobre necesidades concretas con mentores expertos y seguimiento en Teamboarding. Discovery define prioridades; Incubation combina desarrollo de software y formación dentro del proyecto.</p>
          <p class="p p--sm">Starter AI y Booster AI incluyen Charlas AI como punto de partida y acompañamiento a los líderes.</p>
          <div class="panel-exp__links">
            <a class="enlace" href="/metodologia">Conocer la metodología</a>
            <a class="enlace" href="/teamboarding">Conocer Teamboarding</a>
          </div>
        </div>
      </div>
    </section>

    <CierreCoral
      titulo="Data Driven On-the-job Tech Training"
      texto="Conversemos sobre cómo potenciar su compañía con AI."
      textura
    />
  </main>
</Layout>

<style>
  .h2 { font-size: 36px; line-height: 1.12; margin: 0; }
  .mb28 { margin-bottom: 28px; }
  .mb16 { margin-bottom: 16px; }
  /* «Una forma de construir experiencia.» es 32px en el v2 */
  .panel-exp .h2 { font-size: 32px; }
  .h3 { font-size: 24px; line-height: 1.15; margin: 0 0 8px; }
  .p {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.5;
    max-width: 62ch;
    margin: 0;
  }

  .titulo-capas { padding-block: 24px 0; }

  .capas-svc { padding-block: 40px 88px; }
  .capas-svc__wrap { display: flex; flex-direction: column; gap: 64px; }
  .capa-svc__titulo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 30ch;
    margin: 0 0 12px;
  }
  .capa-svc__bajada {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.5;
    max-width: 68ch;
    margin: 0 0 24px;
  }
  .capa-svc__etiqueta { font-weight: 700; color: var(--color-coral); }

  .scards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: stretch;
  }
  .scard {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    background: var(--color-gris-claro);
    border-radius: var(--radius-tarjeta);
    padding: 24px;
    color: var(--color-tinta);
    text-decoration: none;
    transition: opacity 160ms ease-out;
  }
  .scard:hover { opacity: 0.9; }
  .scard__necesita { font-family: var(--font-body); font-weight: 600; font-size: 16px; color: var(--color-gris-texto); margin: 0; }
  .scard__titulo { font-size: 22px; line-height: 1.12; color: var(--color-coral); margin: 0; }
  .scard__resumen { font-family: var(--font-body); font-weight: 500; font-size: 18px; line-height: 1.5; margin: 0; }
  .scard__meta {
    margin: auto 0 0;
    padding-top: 12px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.5;
  }

  .primer-paso { padding-block: 0 96px; }
  .dos-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .dos-col .p { font-size: 20px; }

  .panel-exp-sec { padding-block: 0 112px; }
  .panel-exp {
    background: var(--color-gris-claro);
    border-radius: var(--radius-tarjeta);
    padding: 48px;
  }
  .panel-exp .p { max-width: 70ch; margin-bottom: 14px; }
  .panel-exp .p--sm { font-size: 19px; margin-bottom: 24px; }
  .panel-exp__links { display: flex; flex-wrap: wrap; gap: 20px; }

  @media (max-width: 1100px) {
    .capas-svc { padding-block: 40px 64px; }
    .scards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dos-col { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 720px) {
    .scards { grid-template-columns: 1fr; }
    .panel-exp { padding: 32px 24px; }
    .primer-paso { padding-bottom: 56px; }
    .panel-exp-sec { padding-bottom: 56px; }
  }
</style>
