---
import Layout from "../layouts/Layout.astro";
import ServiciosBody from "../components/pages/ServiciosBody.astro";
import { serviciosContent } from "../content/servicios";
import { servicios, ORDEN } from "../data/servicios";
import { breadcrumbSchema, itemListSchema } from "../lib/seo";

const c = serviciosContent.es;
const translations = { es: "/servicios", en: "/en/services", pt: "/pt/servicos" };
const lista = itemListSchema(ORDEN.map((k) => servicios[k]), "/servicios");
const schema = [
  breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Servicios", path: "/servicios" }]),
  lista,
];
---

<Layout title={c.seoTitle} description={c.seoDesc} lang="es" translations={translations} schema={schema} webPage={{ type: "CollectionPage", mainEntity: lista["@id"] }}>
  <ServiciosBody lang="es" />
</Layout>
