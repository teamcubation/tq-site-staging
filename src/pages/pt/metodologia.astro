---
import Layout from "../../layouts/Layout.astro";
import MetodologiaBody from "../../components/pages/MetodologiaBody.astro";
import { metodologiaContent } from "../../content/metodologia";
import { breadcrumbSchema } from "../../lib/seo";

const c = metodologiaContent.pt;
const translations = { es: "/metodologia", en: "/en/methodology", pt: "/pt/metodologia" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="pt"
  translations={translations}
  schema={[breadcrumbSchema([{ name: "Início", path: "/pt/" }, { name: "Metodologia", path: "/pt/metodologia" }])]}
>
  <MetodologiaBody lang="pt" />
</Layout>
