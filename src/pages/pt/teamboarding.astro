---
import Layout from "../../layouts/Layout.astro";
import TeamboardingBody from "../../components/pages/TeamboardingBody.astro";
import { teamboardingContent } from "../../content/teamboarding";
import { breadcrumbSchema, faqSchema, ids, teamboardingSchema } from "../../lib/seo";

const c = teamboardingContent.pt;
const translations = { es: "/teamboarding", en: "/en/teamboarding", pt: "/pt/teamboarding" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="pt"
  translations={translations}
  schema={[
    teamboardingSchema("pt"),
    breadcrumbSchema([{ name: "Início", path: "/pt/" }, { name: "Teamboarding", path: "/pt/teamboarding" }]),
    faqSchema("/pt/teamboarding", c.faqs, "pt"),
  ]}
  webPage={{ mainEntity: ids.teamboarding }}
>
  <TeamboardingBody lang="pt" />
</Layout>
