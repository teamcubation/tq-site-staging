---
import Layout from "../../layouts/Layout.astro";
import CasosBody from "../../components/pages/CasosBody.astro";
import { casosContent } from "../../content/casos";
import { breadcrumbSchema } from "../../lib/seo";

const c = casosContent.pt;
const translations = { es: "/casos", en: "/en/clients", pt: "/pt/clientes" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="pt"
  translations={translations}
  schema={[breadcrumbSchema([{ name: "Início", path: "/pt/" }, { name: "Clientes", path: "/pt/clientes" }])]}
>
  <CasosBody lang="pt" />
</Layout>
