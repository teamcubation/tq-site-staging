---
import Layout from "../../layouts/Layout.astro";
import ServiciosBody from "../../components/pages/ServiciosBody.astro";
import { serviciosContent } from "../../content/servicios";
import { serviciosPt, ORDEN } from "../../data/servicios";
import { breadcrumbSchema, itemListSchema } from "../../lib/seo";

const c = serviciosContent.pt;
const translations = { es: "/servicios", en: "/en/services", pt: "/pt/servicos" };
const schema = [
  breadcrumbSchema([{ name: "Início", path: "/pt/" }, { name: "Serviços", path: "/pt/servicos" }]),
  itemListSchema(
    ORDEN.map((k) => ({
      nombre: serviciosPt[k].nombre,
      slug: `/pt/servicos/${serviciosPt[k].slug.replace("/servicios/", "")}`,
    }))
  ),
];
---

<Layout title={c.seoTitle} description={c.seoDesc} lang="pt" translations={translations} schema={schema}>
  <ServiciosBody lang="pt" />
</Layout>
