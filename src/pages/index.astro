---
import Layout from "../layouts/Layout.astro";
import HomeBody from "../components/home/HomeBody.astro";
import { websiteSchema } from "../lib/seo";

const translations = { es: "/", en: "/en/", pt: "/pt/" };
---

<Layout
  title="Adopción de IA en empresas | Teamcubation"
  description="Entrenamos a sus equipos para adoptar IA con impacto real en el negocio. Aprenden trabajando sobre procesos y proyectos reales, guiados por mentores expertos."
  lang="es"
  schema={[websiteSchema("es")]}
  translations={translations}
>
  <HomeBody lang="es" />
</Layout>
