---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import HeroHome from "../components/home/HeroHome.astro";
import TiraLogos from "../components/home/TiraLogos.astro";
import CapasApiladas from "../components/home/CapasApiladas.astro";
import CierreCoral from "../components/CierreCoral.astro";
import piramide from "../assets/home/piramide-densa.png";
import mentora from "../assets/home/mentora-laptop-dupla.png";
import equipoResultado from "../assets/home/equipo-resultado.png";
import esferaAmbar from "../assets/home/esfera-ambar.png";
import esferaLima from "../assets/home/esfera-lima.png";
import aiRank from "../assets/home/ai-rank-bloques.png";
---

<Layout
  title="Adopción de IA en empresas | Teamcubation"
  description="Entrenamos a sus equipos para adoptar IA con impacto real en el negocio. Aprenden trabajando sobre procesos y proyectos reales, guiados por mentores expertos."
>
  <main id="contenido">
    <!-- 01 · Hero -->
    <HeroHome />

    <!-- 02 · Tira de logos -->
    <TiraLogos />

    <!-- 03 · Capacidad (banda lima) -->
    <section class="cap">
      <div class="contenedor cap__inner">
        <div class="cap__texto">
          <h2 class="cap__h2">
            Desarrollamos la capacidad de tu empresa para usar y construir la tecnología que
            necesita.
          </h2>
          <div class="cap__lista">
            <p>En Teamcubation entrenamos a los equipos sobre sus propios procesos y proyectos:</p>
            <ul>
              <li>
                <img src={esferaAmbar.src} alt="" aria-hidden="true" width="9" height="9" />
                <span>Acompañamos a las personas no técnicas que necesitan incorporar IA a su trabajo.</span>
              </li>
              <li>
                <img src={esferaAmbar.src} alt="" aria-hidden="true" width="9" height="9" />
                <span>También entrenamos a nuevos desarrolladores mientras construyen el software que la empresa necesita.</span>
              </li>
            </ul>
          </div>
          <p class="cap__p">
            La experiencia que se construye haciendo queda en las personas y les permite
            encarar el siguiente desafío con más autonomía.
          </p>
          <div class="chips">
            <span class="chip">Procesos reales</span>
            <span class="chip">Experiencia</span>
            <span class="chip">Capacidad</span>
          </div>
          <p class="cap__link"><a class="enlace" href="/metodologia">Conocer nuestra metodología</a></p>
        </div>
        <div class="cap__media">
          <Image
            src={piramide}
            alt="Torre de concreto blanco en contrapicado que equipos verdes y naranjas escalan con piezas ámbar y lima"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- 04 · Criterio + Capacidad (dos columnas con foto) -->
    <section class="dosfotos">
      <div class="contenedor dosfotos__grid">
        <div class="ff">
          <div class="ff__foto">
            <Image src={mentora} alt="Una mentora señala la pantalla de una laptop junto a un colaborador que toma notas" loading="lazy" />
          </div>
          <h2 class="ff__h2">El <span class="resaltado">criterio</span> se forma haciendo.</h2>
          <p class="ff__p">
            Tener acceso a una herramienta es el comienzo. Aprender a pensar de forma sistemica,
            elegir qué problema resolver, entender cómo funciona una solución y evaluar como
            implementarla requiere ejecución sobre el trabajo real.
          </p>
          <p class="ff__link"><a class="enlace" href="/metodologia">Conoce nuestra metodología</a></p>
        </div>
        <div class="ff ff--stretch">
          <div class="ff__foto">
            <Image src={equipoResultado} alt="Equipo mirando un resultado en pantalla" loading="lazy" />
          </div>
          <h2 class="ff__h2">La capacidad queda en las personas.</h2>
          <div class="ff__panel">
            <p>
              Nuestro objetivo es que cada equipo pueda sostener lo que construye y resolver el
              siguiente problema con más autonomía.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 · Necesidades y programas (3 capas apiladas) -->
    <CapasApiladas />

    <!-- 06 · AI Rank (banda lima) -->
    <section class="airank">
      <div class="contenedor">
        <article class="airank__grid">
          <div>
            <p class="airank__eyebrow">Diagnóstico ·&nbsp;sin costo</p>
            <h2 class="airank__h2">¿Cómo usan la IA las persona de su organización?</h2>
            <p class="airank__intro">
              Antes de elegir un programa conviene saber de dónde parte cada persona.
            </p>
          </div>
          <div>
            <a class="airank__card" href="https://airank.teamcubation.com" target="_blank" rel="noopener">
              <div class="airank__body">
                <h3 class="airank__titulo">AI Rank</h3>
                <p class="airank__desc">
                  Diagnóstico gratuito de adopción de IA. Mide el nivel real de cada persona por
                  rol y por dimensión.
                </p>
                <ul class="airank__lista">
                  <li>
                    <img src={esferaLima.src} alt="" aria-hidden="true" width="9" height="9" />
                    <span>La distancia entre el nivel actual y el que necesita su empresa</span>
                  </li>
                  <li>
                    <img src={esferaLima.src} alt="" aria-hidden="true" width="9" height="9" />
                    <span>Qué programa corresponde según la brecha</span>
                  </li>
                  <li>
                    <img src={esferaLima.src} alt="" aria-hidden="true" width="9" height="9" />
                    <span>Sin costo y sin compromiso.</span>
                  </li>
                </ul>
                <p class="airank__accion">Hacer el diagnóstico</p>
              </div>
              <img
                class="airank__img"
                src={aiRank.src}
                alt="Escalones de concreto que equipos verdes suben con piezas de vidrio lima y resina ámbar, mientras un mentor naranja señala desde arriba"
              />
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- 07 · Evidencia -->
    <section class="evid">
      <div class="contenedor">
        <h2 class="evid__h2">Experiencia construida con empresas de distintos sectores.</h2>
        <p class="evid__p">
          Trabajamos con más de 90 empresas líderes en Argentina, Brasil, Uruguay, Colombia y
          España. Entre nuestros clientes están empresas como Mercado Libre, Coca-Cola y Visa.
        </p>
        <div class="evid__cards">
          <div class="stat">
            <p class="stat__num">+90</p>
            <p class="stat__lbl">Más de 90 empresas líderes.</p>
          </div>
          <div class="stat">
            <p class="stat__num">5</p>
            <p class="stat__lbl">5 países: Argentina, Brasil, Uruguay, Colombia y España.</p>
          </div>
          <div class="stat">
            <p class="stat__num">35%</p>
            <p class="stat__lbl">Hasta 35% de mejora de eficiencia en los procesos intervenidos.</p>
          </div>
        </div>
      </div>
      <div class="evid__tira"><TiraLogos /></div>
      <div class="contenedor evid__link">
        <a class="enlace" href="/casos">Conocer nuestra trayectoria</a>
      </div>
    </section>

    <!-- 08 · Cierre -->
    <CierreCoral
      titulo="Data Driven On-the-job Tech Training"
      texto="Conversemos sobre cómo potenciar su compañía con AI."
    />
  </main>
</Layout>

<style>
  .enlace {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 19px;
    color: var(--color-tinta);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  /* 03 · Capacidad (banda lima) */
  .cap { background: var(--color-lima); padding: 80px 0 0; overflow: hidden; }
  .cap__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: end;
  }
  .cap__texto { padding-bottom: 80px; }
  .cap__h2 {
    font-size: 36px;
    line-height: 1.12;
    max-width: 22ch;
    margin: 0 0 20px;
  }
  .cap__lista {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.28;
    max-width: 66ch;
    margin: 0 0 16px;
  }
  .cap__lista ul { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 10px; }
  .cap__lista li { display: grid; grid-template-columns: 9px 1fr; gap: 10px; align-items: start; }
  .cap__lista li img { margin-top: 11px; display: block; }
  .cap__p {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.28;
    max-width: 66ch;
    margin: 0;
  }
  .chips { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  .chip {
    background: #fff;
    border-radius: var(--radius-capsula);
    padding: 8px 18px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 17px;
  }
  .cap__link { margin: 24px 0 0; }
  .cap__media :global(img) {
    width: 132%;
    max-width: 132%;
    height: auto;
    margin: 0 -16% -1px auto;
    object-fit: contain;
    display: block;
    align-self: end;
  }

  /* 04 · Dos fotos */
  .dosfotos { padding: 112px 0 0; }
  .dosfotos__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: stretch;
  }
  .ff--stretch { display: flex; flex-direction: column; }
  .ff__foto { height: 220px; margin: 0 0 20px; border-radius: var(--radius-tarjeta); overflow: hidden; }
  .ff__foto :global(img) { width: 100%; height: 220px; object-fit: cover; display: block; }
  .ff__h2 { font-size: 36px; line-height: 1.12; margin: 0 0 20px; }
  .ff__p {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.5;
    max-width: 64ch;
    margin: 0 0 20px;
  }
  .ff__panel {
    flex: 1;
    background: var(--color-coral);
    border-radius: var(--radius-tarjeta);
    padding: 28px 32px;
  }
  .ff__panel p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.5;
    color: #fff;
  }

  /* 06 · AI Rank (banda lima) */
  .airank { background: var(--color-lima); padding: 64px 0; }
  .airank__grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 1.2fr);
    gap: 48px;
    align-items: center;
  }
  .airank__eyebrow {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.2;
    color: var(--color-coral);
    margin: 0 0 14px;
  }
  .airank__h2 { font-size: 48px; line-height: 1.12; margin: 0; }
  .airank__intro {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.35;
    max-width: 44ch;
    margin: 18px 0 0;
  }
  .airank__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    gap: 24px;
    align-items: center;
    background: #fff;
    border-radius: var(--radius-tarjeta);
    padding: 24px;
    color: var(--color-tinta);
    text-decoration: none;
    transition: opacity 160ms ease-out;
  }
  .airank__card:hover { opacity: 0.92; }
  .airank__body { display: flex; flex-direction: column; gap: 12px; }
  .airank__titulo { font-size: 22px; line-height: 1.12; color: var(--color-coral); margin: 0; }
  .airank__desc,
  .airank__lista {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.35;
    margin: 0;
  }
  .airank__lista { list-style: none; padding: 0; display: grid; gap: 8px; }
  .airank__lista li { display: grid; grid-template-columns: 9px 1fr; gap: 10px; align-items: start; }
  .airank__lista li img { margin-top: 8px; display: block; }
  .airank__accion { margin: 0; font-family: var(--font-body); font-weight: 700; font-size: 18px; }
  .airank__img { width: 100%; height: 160px; object-fit: contain; display: block; }

  /* 07 · Evidencia */
  .evid { padding: 112px 0; }
  .evid__h2 { font-size: 40px; line-height: 1.12; max-width: 26ch; margin: 0 0 20px; }
  .evid__p {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.5;
    max-width: 70ch;
    margin: 0 0 32px;
  }
  .evid__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .stat { background: var(--color-gris-claro); border-radius: var(--radius-tarjeta); padding: 32px; }
  .stat__num {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 52px;
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .stat__lbl { font-family: var(--font-body); font-weight: 500; font-size: 19px; margin: 8px 0 0; }
  .evid__tira { margin-top: 32px; }
  .evid__link { margin-top: 20px; }

  @media (max-width: 1100px) {
    .cap__inner,
    .airank__grid { grid-template-columns: 1fr; gap: 32px; }
    .cap { padding-bottom: 0; }
    .cap__texto { padding-bottom: 40px; }
    .dosfotos__grid { grid-template-columns: 1fr; gap: 40px; }
    .airank__h2 { font-size: 38px; }
  }
  @media (max-width: 760px) {
    .airank__card { grid-template-columns: 1fr; }
    .airank__img { height: 140px; }
  }
  @media (max-width: 720px) {
    .dosfotos { padding-top: 56px; }
    .evid { padding: 56px 0; }
    .evid__cards { grid-template-columns: 1fr; }
    .cap__h2,
    .ff__h2,
    .evid__h2 { font-size: 30px; }
    .airank__h2 { font-size: 30px; }
  }
</style>
