---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Cta from "../components/Cta.astro";
import Faq from "../components/Faq.astro";
import CierreCoral from "../components/CierreCoral.astro";
import mural from "../assets/ilustraciones/mural-frontal-placas-figuras.png";
import disco from "../assets/ilustraciones/macro-empuje-disco-ambar.png";

const registra = [
  {
    titulo: "Impacto en lo trabajado.",
    texto: "El trabajo sobre el proceso, la aplicación o el desarrollo que aborda cada participante, según el programa.",
  },
  {
    titulo: "Crecimiento de habilidades.",
    texto: "El avance de las personas a lo largo del entrenamiento, para acompañar su recorrido y adaptar el trabajo a su nivel.",
  },
  {
    titulo: "Participación en el programa.",
    texto: "Asistencia, horas de mentoría y satisfacción de participantes y responsables: información para seguir cómo se desarrolla el entrenamiento.",
  },
];

const informacion = [
  {
    titulo: "Informes de avance e impacto.",
    texto: "Los responsables del programa reciben información sobre el recorrido de las personas y el trabajo sobre los procesos.",
  },
  {
    titulo: "Guías y resúmenes.",
    texto: "El entrenamiento deja materiales de referencia que ayudan a recuperar y reutilizar lo trabajado.",
  },
  {
    titulo: "Un recorrido que se adapta.",
    texto: "La información registrada ayuda a personalizar el acompañamiento según el nivel y el avance de cada participante.",
  },
];

const faqs = [
  {
    pregunta: "¿Teamboarding es parte de Teamcubation?",
    respuesta: "Sí. Teamboarding es nuestra plataforma propia. Funciona como copiloto del mentor: ordena el proceso, resguarda su cumplimiento y hace visible el avance y los resultados en tiempo real.",
  },
  {
    pregunta: "¿La plataforma reemplaza al mentor?",
    respuesta: "El trabajo del mentor y los datos de Teamboarding se complementan. La persona entrena con acompañamiento experto; la plataforma registra información para seguir y personalizar el recorrido.",
  },
  {
    pregunta: "¿Cómo puede conocerla el responsable de mi empresa?",
    respuesta: "Podemos conversar sobre el programa que necesita su equipo y cómo se acompaña su avance con Teamboarding.",
  },
];
---

<Layout
  title="Teamboarding: cómo medimos el avance y el impacto | Teamcubation"
  description="Teamboarding es la plataforma propia de Teamcubation que registra el avance de cada persona y el impacto en cada proceso, y genera los informes que recibe el sponsor."
>
  <main id="contenido">
    <!-- Hero -->
    <section class="hero-tb">
      <div class="contenedor hero-tb__grid">
        <div>
          <p class="kicker">Teamboarding / Nuestra tecnología</p>
          <h1 class="hero-tb__h1">Teamboarding: es cómo medimos el avance y el impacto de la adopción de IA.</h1>
          <p class="hero-tb__sub">Detrás de cada entrenamiento: datos.</p>
          <p class="hero-tb__bajada">Teamboarding es la plataforma propietaria de Teamcubation que registra el avance de cada persona y el impacto en cada proceso, personaliza el entrenamiento y genera los informes que recibe el sponsor.</p>
          <p class="hero-tb__nota">El sponsor es el responsable del programa dentro de su empresa. Los datos acompañan el trabajo de los mentores y permiten seguir el recorrido del equipo.</p>
          <div class="chips">
            <span class="chip">Personas</span>
            <span class="chip">Procesos</span>
            <span class="chip">Informes</span>
          </div>
          <div class="hero-tb__cta"><Cta /></div>
        </div>
        <div class="hero-tb__media">
          <Image src={mural} alt="Mural de placas de concreto donde figuras registran el avance del equipo" loading="eager" />
        </div>
      </div>
    </section>

    <!-- Qué registra (banda gris) -->
    <section class="registra">
      <div class="contenedor">
        <h2 class="h2-36 mb32">¿Qué registra Teamboarding?</h2>
        <div class="cards3">
          {registra.map((c) => (
            <article class="card-blanco">
              <h3 class="card__titulo">{c.titulo}</h3>
              <p class="card__p">{c.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Información que sirve -->
    <section class="sec">
      <div class="contenedor info-grid">
        <h2 class="h2-32">Información que sirve para acompañar al equipo.</h2>
        <div class="info-lista">
          {informacion.map((i) => (
            <div class="info-row">
              <h3 class="h3-24">{i.titulo}</h3>
              <p class="p20">{i.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Mentoría humana + datos -->
    <section class="sec sec--flush-b">
      <div class="contenedor dos-col">
        <div>
          <h2 class="h2-32 mb20">Mentoría humana y guiada por datos.</h2>
          <p class="p21 mb24">El mentor trabaja junto a las personas. Teamboarding aporta información para acompañar ese trabajo. Son los dos motores del método de Teamcubation: experiencia humana y seguimiento del recorrido con IA.</p>
          <div class="links">
            <a class="enlace" href="/metodologia">Conocer la metodología</a>
            <a class="enlace" href="/servicios">Comparar los programas</a>
          </div>
        </div>
        <div class="media360">
          <Image src={disco} alt="Figuras empujando juntas un disco ámbar sobre una placa de concreto" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec sec--flush-b2">
      <div class="contenedor">
        <h2 class="h2-32 mb32">Preguntas sobre Teamboarding.</h2>
        <Faq items={faqs} />
      </div>
    </section>

    <CierreCoral
      titulo="Data Driven On-the-job Tech Training"
      texto="Conversemos sobre cómo potenciar su compañía con AI."
      enlaceExtra={{ label: "Conocer la plataforma Teamboarding", href: "https://teamboarding.com" }}
    />
  </main>
</Layout>

<style>
  .h2-36 { font-size: 36px; line-height: 1.12; margin: 0; }
  .h2-32 { font-size: 32px; line-height: 1.12; margin: 0; }
  .h3-24 { font-size: 24px; line-height: 1.15; margin: 0 0 8px; }
  .mb32 { margin-bottom: 32px; }
  .mb24 { margin-bottom: 24px; }
  .mb20 { margin-bottom: 20px; }
  .p20 { font-family: var(--font-body); font-weight: 500; font-size: 20px; line-height: 1.5; margin: 0; }
  .p21 { font-family: var(--font-body); font-weight: 500; font-size: 21px; line-height: 1.5; max-width: 62ch; margin: 0; }

  .sec { padding-block: 96px; }
  .sec--flush-b { padding-block: 0 112px; }
  .sec--flush-b2 { padding-block: 0 96px; }

  /* Hero */
  .hero-tb { padding-block: 72px 88px; }
  .hero-tb__grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .hero-tb__h1 { font-size: clamp(36px, 4.2vw, 56px); line-height: 1.1; letter-spacing: -0.02em; max-width: 20ch; margin: 0; }
  .hero-tb__sub { font-family: var(--font-display); font-weight: 600; font-size: 22px; line-height: 1.2; color: var(--color-coral); margin: 18px 0 0; }
  .hero-tb__bajada { font-family: var(--font-body); font-weight: 500; font-size: 23px; line-height: 1.45; max-width: 60ch; margin: 18px 0 0; }
  .hero-tb__nota { font-family: var(--font-body); font-weight: 500; font-size: 19px; line-height: 1.5; color: var(--color-gris-texto); max-width: 60ch; margin: 16px 0 0; }
  .hero-tb__cta { margin-top: 28px; }
  .hero-tb__media :global(img) { width: 100%; height: auto; max-height: 420px; object-fit: contain; display: block; margin-inline: auto; }

  .chips { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }
  .chip { background: var(--color-gris-claro); border-radius: var(--radius-capsula); padding: 8px 18px; font-family: var(--font-display); font-weight: 500; font-size: 17px; }

  /* Qué registra */
  .registra { background: var(--color-gris-claro); padding-block: 88px; }
  .cards3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .card-blanco { background: #fff; border-radius: var(--radius-tarjeta); padding: 24px; }
  .card__titulo { font-size: 22px; line-height: 1.12; color: var(--color-coral); margin: 0; }
  .card__p { font-family: var(--font-body); font-weight: 500; font-size: 18px; line-height: 1.5; margin: 12px 0 0; }

  /* Información */
  .info-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: start; }
  .info-lista { border-top: 1px solid var(--color-linea); }
  .info-row { padding: 22px 0; border-bottom: 1px solid var(--color-linea); }

  /* Mentoría */
  .dos-col { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .links { display: flex; flex-wrap: wrap; gap: 20px; }
  .media360 :global(img) { width: 100%; height: auto; max-height: 360px; object-fit: contain; display: block; }

  @media (max-width: 1100px) {
    .sec { padding-block: 64px; }
    .registra { padding-block: 64px; }
    .hero-tb__grid,
    .info-grid,
    .dos-col { grid-template-columns: 1fr; gap: 40px; }
    .cards3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .cards3 { grid-template-columns: 1fr; }
    .sec--flush-b { padding-bottom: 56px; }
    .sec--flush-b2 { padding-bottom: 56px; }
  }
</style>
