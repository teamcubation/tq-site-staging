---
import Layout from "../layouts/Layout.astro";
import TeamboardingBody from "../components/pages/TeamboardingBody.astro";
import { teamboardingContent } from "../content/teamboarding";
import { breadcrumbSchema } from "../lib/seo";

const c = teamboardingContent.es;
const translations = { es: "/teamboarding", en: "/en/teamboarding", pt: "/pt/teamboarding" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="es"
  translations={translations}
  schema={[breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Teamboarding", path: "/teamboarding" }])]}
>
  <TeamboardingBody lang="es" />
</Layout>
