---
import Layout from "../layouts/Layout.astro";
import { breadcrumbSchema } from "../lib/seo";

const faqs = [
  {
    pregunta: "¿Necesito haber elegido un programa?",
    respuesta: "No. Podemos conversar sobre el objetivo de su equipo y evaluar qué programa corresponde.",
  },
  {
    pregunta: "¿Puedo contactar si mi empresa todavía no usa IA?",
    respuesta: "Sí. Podemos revisar el punto de partida y evaluar si conviene empezar con Starter AI o realizar un Discovery para priorizar oportunidades.",
  },
];

const ayuda = [
  { titulo: "El equipo.", texto: "Quiénes participan y qué experiencia tienen usando IA o desarrollando software." },
  { titulo: "El punto de partida.", texto: "Qué herramientas utilizan hoy y qué resultado quieren alcanzar." },
];
---

<Layout
  title="Contacto | Teamcubation"
  description="Conversemos sobre el próximo paso de su equipo: qué proceso necesita mejorar, qué quiere construir y qué programa se ajusta a su necesidad."
  schema={[breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Contacto", path: "/contacto" }])]}
>
  <main id="contenido">
    <!-- Hero -->
    <section class="hero-cont">
      <div class="contenedor">
        <nav class="miga-coral" aria-label="Ruta de navegación">
          <a href="/">Inicio</a><span> / Contacto</span>
        </nav>
        <h1 class="hero-cont__h1">Conversemos sobre el próximo paso de su equipo.</h1>
        <p class="hero-cont__p">Cuéntenos qué proceso necesita mejorar, qué quiere construir y cómo trabaja hoy su equipo. En una conversación con Teamcubation podemos identificar qué programa se ajusta a su necesidad y qué información hace falta para definir el primer paso.</p>
      </div>
    </section>

    <!-- Formulario -->
    <section class="sec-form" id="formulario">
      <div class="contenedor">
        <div class="form-exito" data-form-exito hidden>
          <h2 class="h2-30">Recibimos su mensaje.</h2>
          <p class="form-exito__p">Nos pondremos en contacto en menos de 48 horas hábiles para coordinar la conversación.</p>
        </div>

        <div data-form-wrap>
          <form class="form" data-contacto-form novalidate>
            <div class="form__grid">
              <label class="campo">
                <span class="campo__label">¿Cómo se identifica?</span>
                <span class="select-wrap">
                  <select name="perfil" required>
                    <option value="">Seleccione una opción</option>
                    <option value="empresa">Represento a una empresa</option>
                    <option value="rrhh">Trabajo en RRHH o desarrollo de talento</option>
                    <option value="tech">Lidero un equipo de tecnología</option>
                    <option value="persona">Busco entrenarme individualmente</option>
                    <option value="otro">Otro</option>
                  </select>
                  <svg class="select-arrow" aria-hidden="true" width="16" height="10" viewBox="0 0 16 10">
                    <path d="M1 1l7 7 7-7" fill="none" stroke="#171414" stroke-width="1.5"></path>
                  </svg>
                </span>
              </label>

              <label class="campo">
                <span class="campo__label">Nombre</span>
                <input name="nombre" type="text" required autocomplete="name" />
              </label>

              <label class="campo">
                <span class="campo__label">Email</span>
                <input name="email" type="email" required autocomplete="email" />
              </label>

              <div class="campo">
                <span class="campo__label">Teléfono</span>
                <div class="tel">
                  <span class="tel__mas" aria-hidden="true">+</span>
                  <input name="pais" type="tel" inputmode="numeric" placeholder="País" aria-label="Código de país" />
                  <input name="area" type="tel" inputmode="numeric" placeholder="Área" aria-label="Código de área" />
                  <input name="numero" type="tel" inputmode="numeric" placeholder="Número" aria-label="Número" />
                </div>
              </div>
            </div>

            <label class="campo">
              <span class="campo__label">Su mensaje</span>
              <textarea name="mensaje" rows="5" required placeholder="Qué proceso necesita mejorar, qué quiere construir y cómo trabaja hoy su equipo."></textarea>
            </label>

            <p class="form__error" role="alert" data-form-error hidden>
              Complete cómo se identifica, su nombre, un email válido y el mensaje.
            </p>

            <div>
              <button type="submit" class="btn-enviar">Enviar mensaje</button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Qué nos ayuda -->
    <section class="sec-b96">
      <div class="contenedor">
        <h2 class="h2-36 mb28">¿Qué nos ayuda a entender su necesidad?</h2>
        <div class="cards3">
          {ayuda.map((c) => (
            <article class="card-gris">
              <h3 class="card__titulo">{c.titulo}</h3>
              <p class="card__p">{c.texto}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Antes de conversar (FAQ) -->
    <section class="sec-b112">
      <div class="contenedor">
        <h2 class="h2-32 mb28">Antes de conversar.</h2>
        <div class="cards2">
          {faqs.map((f) => (
            <article class="card-gris">
              <h3 class="faq__q">{f.pregunta}</h3>
              <p class="card__p">{f.respuesta}</p>
            </article>
          ))}
        </div>
        <p class="link-final"><a class="enlace" href="/servicios">Comparar los programas de Teamcubation</a></p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .h2-30 { font-size: 30px; line-height: 1.12; margin: 0; }
  .h2-32 { font-size: 32px; line-height: 1.12; margin: 0; }
  .h2-36 { font-size: 36px; line-height: 1.12; margin: 0; }
  .mb28 { margin-bottom: 28px; }

  /* Hero */
  .hero-cont { padding-block: 72px 96px; }
  .hero-cont__h1 { font-size: clamp(34px, 3.8vw, 48px); line-height: 1.1; letter-spacing: -0.02em; max-width: 20ch; margin: 0; }
  .hero-cont__p { font-family: var(--font-body); font-weight: 500; font-size: 22px; line-height: 1.5; max-width: 58ch; margin: 24px 0 0; }

  .miga-coral { font-family: var(--font-display); font-weight: 650; font-size: clamp(17px, 1.5vw, 25px); line-height: 1.2; color: var(--color-coral); margin: 0 0 14px; }
  .miga-coral a { color: var(--color-coral); text-decoration: none; }
  .miga-coral a:hover { text-decoration: underline; }

  /* Formulario */
  .sec-form { padding-block: 0 96px; }
  .form { display: grid; gap: 20px; }
  .form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 32px; }
  .campo { display: grid; gap: 6px; }
  .campo__label { font-family: var(--font-body); font-weight: 600; font-size: 18px; line-height: 1.2; color: var(--color-tinta); }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    padding: 0 12px;
    height: 44px;
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-control);
    background: #fff;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 18px;
    color: var(--color-tinta);
  }
  .campo textarea { min-height: 140px; height: auto; padding: 10px 12px; line-height: 1.45; resize: vertical; }
  .campo input:focus,
  .campo select:focus,
  .campo textarea:focus { outline: none; border: 1.5px solid var(--color-tinta); }

  .select-wrap { position: relative; display: block; }
  .campo select { appearance: none; -webkit-appearance: none; padding-right: 44px; }
  .select-arrow { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; display: block; }

  .tel { display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr); gap: 12px; align-items: center; }
  .tel__mas { font-family: var(--font-body); font-weight: 600; font-size: 22px; color: var(--color-gris-texto); }

  .form__error { margin: 0; font-family: var(--font-body); font-weight: 700; font-size: 14px; color: var(--color-coral); }

  .btn-enviar {
    background: var(--color-lima);
    color: var(--color-coral);
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 26px;
    line-height: 1.2;
    border: 0;
    border-radius: var(--radius-capsula);
    padding: 0.45em 1.4em;
    cursor: pointer;
    transition: opacity 160ms ease-out;
  }
  .btn-enviar:hover { opacity: 0.9; }

  .form-exito { background: var(--color-lima); border-radius: var(--radius-tarjeta); padding: 40px; }
  .form-exito__p { font-family: var(--font-body); font-weight: 500; font-size: 21px; line-height: 1.5; max-width: 60ch; margin: 12px 0 0; }

  /* Qué nos ayuda / FAQ */
  .sec-b96 { padding-block: 0 96px; }
  .sec-b112 { padding-block: 0 112px; }
  .cards3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .cards2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .card-gris { background: var(--color-gris-claro); border-radius: var(--radius-tarjeta); padding: 24px; }
  .card__titulo { font-size: 22px; line-height: 1.12; color: var(--color-coral); margin: 0; }
  .faq__q { font-size: 21px; line-height: 1.15; color: var(--color-coral); margin: 0; }
  .card__p { font-family: var(--font-body); font-weight: 500; font-size: 19px; line-height: 1.5; margin: 12px 0 0; }
  .cards2 .card__p { font-size: 18px; }
  .link-final { margin: 24px 0 0; }

  [hidden] { display: none !important; }

  @media (max-width: 1100px) {
    .cards3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 720px) {
    .form__grid { grid-template-columns: 1fr; }
    .cards3,
    .cards2 { grid-template-columns: 1fr; }
    .sec-b96 { padding-bottom: 56px; }
    .sec-b112 { padding-bottom: 56px; }
  }
</style>

<script>
  // Validación cliente + estados. El ENVÍO real queda pendiente de conectar
  // con el backend/API (Pipedrive / Google Calendar). Por ahora es un stub.
  const form = document.querySelector<HTMLFormElement>("[data-contacto-form]");
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const email = String(f.get("email") || "");
      const ok =
        f.get("perfil") &&
        String(f.get("nombre") || "").trim() &&
        /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) &&
        String(f.get("mensaje") || "").trim();

      const errorEl = document.querySelector<HTMLElement>("[data-form-error]");
      if (!ok) {
        if (errorEl) errorEl.hidden = false;
        return;
      }
      if (errorEl) errorEl.hidden = true;

      // TODO: enviar los datos al backend/API real. Reemplazar este stub.
      const wrap = document.querySelector<HTMLElement>("[data-form-wrap]");
      const exito = document.querySelector<HTMLElement>("[data-form-exito]");
      if (wrap) wrap.hidden = true;
      if (exito) {
        exito.hidden = false;
        exito.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  }
</script>
