---
import Layout from "../layouts/Layout.astro";
import ContactoBody from "../components/pages/ContactoBody.astro";
import { contactoContent } from "../content/contacto";
import { breadcrumbSchema } from "../lib/seo";

const c = contactoContent.es;
const translations = { es: "/contacto", en: "/en/contact", pt: "/pt/contato" };
---

<Layout
  title={c.seoTitle}
  description={c.seoDesc}
  lang="es"
  translations={translations}
  schema={[breadcrumbSchema([{ name: "Inicio", path: "/" }, { name: "Contacto", path: "/contacto" }])]}
>
  <ContactoBody lang="es" />
</Layout>
