---
import Cta from "./Cta.astro";
import { rutas, ruta, rutaPrograma, conBarra } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { getServicios } from "../data/servicios";
import { defaultLocale, locales, type Locale } from "../i18n/config";

interface Props {
  lang?: Locale;
  /** Path equivalente por idioma (para el selector). Opcional. */
  translations?: Partial<Record<Locale, string>>;
}
const { lang = defaultLocale, translations } = Astro.props;

const navKeys = ["metodologia", "servicios", "teamboarding", "casos", "nosotros"];

// Mega-menú de Servicios (hover) — 3 grupos, como el diseño v2. Discovery queda fuera.
const MENU_GRUPOS: { keys: string[]; titulo: Record<Locale, string> }[] = [
  {
    keys: ["starter", "booster", "intensivo"],
    titulo: {
      es: "IA para el trabajo diario de sus equipos",
      en: "AI for your teams' everyday work",
      pt: "IA para o trabalho diário das suas equipes",
    },
  },
  {
    keys: ["builders", "vibecode"],
    titulo: {
      es: "IA para procesos cross área o masivos",
      en: "AI for cross-area or large-scale processes",
      pt: "IA para processos entre áreas ou em escala",
    },
  },
  {
    keys: ["dev", "incubation"],
    titulo: {
      es: "Talento y capacidad IT",
      en: "IT talent and capability",
      pt: "Talento e capacidade de IT",
    },
  },
];
const svc = getServicios(lang);
const menuServicios = MENU_GRUPOS.map((g) => ({
  titulo: g.titulo[lang],
  items: g.keys.map((k) => ({ label: svc[k].nombre, href: rutaPrograma(svc[k].slug, lang) })),
}));
---

<header class="cabecera" data-cabecera>
  <a class="cabecera__logo" href={ruta("home", lang)} aria-label="Teamcubation">
    <img
      src="/brand/logo-horizontal-color.svg"
      alt="Teamcubation"
      width="173"
      height="38"
      decoding="async"
    />
  </a>

  <button
    class="cabecera__burger"
    data-burger
    type="button"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="menu-principal"
  >
    <span class="cabecera__burger-linea"></span>
    <span class="cabecera__burger-linea"></span>
    <span class="cabecera__burger-linea"></span>
  </button>

  <div class="cabecera__menu" id="menu-principal" data-menu>
    <nav class="cabecera__nav" aria-label={ui[lang].navAria}>
      {navKeys.map((k) => {
        const item = rutas[k][lang];
        return k === "servicios" ? (
          <div class="nav-svc" data-nav-svc>
            <div class="nav-svc__head">
              <a class="nav-svc__trigger" href={item.path}>{item.label}</a>
              <button
                class="nav-svc__icon"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label={item.label}
                data-svc-icon
              >
                <svg class="nav-svc__chevron" width="11" height="7" viewBox="0 0 11 7" aria-hidden="true">
                  <path d="M1 1l4.5 4.5L10 1" fill="none" stroke="currentColor" stroke-width="1.5"></path>
                </svg>
              </button>
            </div>
            <div class="nav-svc__panel">
              <div class="nav-svc__box">
                {menuServicios.map((grupo) => (
                  <div class="nav-svc__grupo">
                    <p class="nav-svc__titulo">{grupo.titulo}</p>
                    <div class="nav-svc__items">
                      {grupo.items.map((s) => <a href={s.href}>{s.label}</a>)}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.path}>{item.label}</a>
        );
      })}
      <a href="https://blog.teamcubation.com/" target="_blank" rel="noopener">Blog</a>
    </nav>

    <div class="cabecera__acciones">
      {translations && (
        <div class="lang" data-lang>
          <button
            class="lang__toggle"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="Idioma"
            data-lang-toggle
          >
            <span>{lang.toUpperCase()}</span>
            <svg class="lang__chevron" width="10" height="7" viewBox="0 0 10 7" aria-hidden="true">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul class="lang__menu" role="menu">
            {locales
              .filter((loc) => loc !== lang && translations[loc])
              .map((loc) => (
                <li role="none">
                  <a role="menuitem" href={conBarra(translations[loc]!)} hreflang={loc} title={ui[loc].langNombre}>{loc.toUpperCase()}</a>
                </li>
              ))}
          </ul>
        </div>
      )}
      <Cta lang={lang} tamano="sm" class="cabecera__cta" />
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 20px 64px;
  }
  .cabecera__logo { flex: none; display: block; }
  .cabecera__logo img { height: 38px; width: auto; display: block; }

  /* Desktop: el wrapper desaparece; logo (izq) y acciones (der) van con
     space-between, y la nav se centra ABSOLUTA en el header → queda siempre
     al medio de la página, sin importar el ancho de logo/acciones. */
  .cabecera__menu { display: contents; }
  .cabecera__burger { display: none; }

  .cabecera__nav { display: flex; align-items: center; gap: 22px; }
  .cabecera__nav a {
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo-semibold);
    font-size: var(--fs-cuerpo);
    color: var(--color-tinta);
    text-decoration: none;
  }
  .cabecera__nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* Mega-menú de Servicios (hover en desktop / acordeón por icono en mobile) — como el v2 */
  .nav-svc { position: relative; display: flex; align-items: center; }
  .nav-svc__head { display: inline-flex; align-items: center; gap: 8px; }
  .nav-svc__icon {
    display: inline-flex;
    align-items: center;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
    color: var(--color-tinta);
  }
  .nav-svc__chevron { display: block; flex: none; transition: transform 0.2s ease; }
  .nav-svc__panel {
    position: absolute;
    top: 100%;
    left: -32px;
    z-index: 120;
    padding-top: 22px; /* puente invisible: el hover no se corta al bajar el cursor */
    display: none;
  }
  /* Desktop (>1200): abre en hover/foco */
  @media (min-width: 1201px) {
    .nav-svc:hover > .nav-svc__panel,
    .nav-svc:focus-within > .nav-svc__panel { display: block; }
  }
  .nav-svc__box {
    display: grid;
    grid-template-columns: repeat(3, minmax(200px, 1fr));
    gap: 32px;
    align-items: stretch;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-tarjeta);
    padding: 28px 32px;
  }
  .nav-svc__grupo { display: flex; flex-direction: column; gap: 12px; }
  .nav-svc__titulo {
    margin: 0;
    min-height: 2.4em;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 19px;
    line-height: 1.2;
    color: var(--color-coral);
    max-width: 24ch;
  }
  .nav-svc__items { display: flex; flex-direction: column; gap: 8px; }
  .nav-svc__items a { font-size: 14px; line-height: 1.3; white-space: nowrap; }
  /* Acciones = solo el CTA en el flujo (como el diseño), para que la nav
     quede posicionada por space-between logo·nav·CTA. El selector de idioma
     se posiciona a la izquierda del CTA sin empujar la nav. */
  .cabecera__acciones { justify-self: end; display: flex; align-items: center; gap: 16px; flex: none; }
  /* Selector de idioma: dropdown compacto (ahorra ancho en el header). */
  .lang { position: relative; }
  .lang__toggle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: var(--color-lima);
    color: var(--color-tinta);
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo-semibold);
    font-size: var(--fs-caption);
    line-height: 1.2;
    border: 0;
    border-radius: var(--radius-capsula);
    padding: 5px 10px;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 160ms ease-out;
  }
  .lang__toggle:hover { background: var(--color-lima-hover); }
  .lang__chevron { transition: transform 0.18s ease; }
  .lang.is-open .lang__chevron { transform: rotate(180deg); }
  .lang__menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    display: none;
    flex-direction: column;
    gap: 4px;
    min-width: 100%;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--color-gris-claro);
    border-radius: 12px;
    z-index: 10;
  }
  .lang.is-open .lang__menu { display: flex; }
  .lang__menu a {
    display: block;
    background: #fff;
    color: var(--color-tinta);
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo-semibold);
    font-size: var(--fs-caption);
    line-height: 1.2;
    border-radius: var(--radius-capsula);
    padding: 6px 12px;
    text-align: center;
    text-decoration: none;
    transition: background-color 160ms ease-out;
  }
  .lang__menu a:hover { background: var(--color-superficie-hover); }

  /* Botón hamburguesa (oculto en desktop, visible ≤1100) */
  .cabecera__burger {
    flex: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 0;
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
  }
  .cabecera__burger-linea {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 2px;
    background: var(--color-tinta);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1200px) {
    .cabecera {
      display: flex;
      justify-content: space-between;
      flex-wrap: nowrap;
      padding-left: 40px;
      padding-right: 40px;
    }
    .cabecera__burger { display: flex; }

    /* Menú colapsable: panel desplegable bajo el header */
    .cabecera__menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 22px;
      padding: 24px 40px 32px;
      background: #fff;
      border-top: 1px solid var(--color-linea);
      box-shadow: 0 10px 24px rgba(23, 20, 20, 0.08);
    }
    .cabecera.is-open .cabecera__menu { display: flex; }

    .cabecera__nav { flex-direction: column; align-items: flex-start; gap: 16px; width: 100%; }
    .cabecera__acciones { flex-direction: column; align-items: flex-start; gap: 18px; width: 100%; }

    /* Servicios: acordeón en el menú colapsable, abre con el icono (chevron) */
    .nav-svc { position: static; display: block; width: 100%; }
    .nav-svc__head { display: flex; align-items: center; justify-content: space-between; width: 100%; }
    .nav-svc__icon { padding: 6px; margin: -6px; }
    .nav-svc.is-open .nav-svc__chevron { transform: rotate(180deg); }
    .nav-svc__panel { position: static; padding-top: 0; } /* colapsado por defecto (display:none base) */
    .nav-svc.is-open > .nav-svc__panel { display: block; }
    .nav-svc__box { grid-template-columns: 1fr; gap: 16px; border: 0; border-radius: 0; padding: 12px 0 0 16px; }
    .nav-svc__titulo { min-height: 0; font-size: 17px; }
    .nav-svc__items a { font-size: var(--fs-secundario); font-weight: var(--peso-cuerpo); white-space: normal; }

    /* En el menú mobile: los 3 idiomas en fila (sin dropdown). */
    .lang { display: flex; flex-direction: row; align-items: center; gap: 8px; }
    .lang__toggle { pointer-events: none; cursor: default; }
    .lang__chevron { display: none; }
    .lang__menu {
      position: static;
      display: flex !important;
      flex-direction: row;
      gap: 8px;
      padding: 0;
      background: transparent;
      min-width: 0;
    }
    .lang__menu a { background: var(--color-gris-claro); }

    /* Hamburguesa → X cuando está abierto */
    .cabecera.is-open .cabecera__burger-linea:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .cabecera.is-open .cabecera__burger-linea:nth-child(2) { opacity: 0; }
    .cabecera.is-open .cabecera__burger-linea:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
  @media (max-width: 720px) {
    .cabecera { padding-left: 24px; padding-right: 24px; }
    .cabecera__menu { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 480px) {
    .cabecera { padding-top: 16px; padding-bottom: 16px; }
    .cabecera__logo img { height: 28px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-cabecera]");
  const burger = header?.querySelector<HTMLButtonElement>("[data-burger]");
  if (header && burger) {
    const cerrar = () => {
      header.classList.remove("is-open");
      burger.setAttribute("aria-expanded", "false");
      burger.setAttribute("aria-label", "Abrir menú");
    };
    burger.addEventListener("click", () => {
      const abierto = header.classList.toggle("is-open");
      burger.setAttribute("aria-expanded", String(abierto));
      burger.setAttribute("aria-label", abierto ? "Cerrar menú" : "Abrir menú");
    });
    // Cerrar al navegar (click en cualquier link del menú)
    header.querySelectorAll(".cabecera__menu a").forEach((a) =>
      a.addEventListener("click", cerrar)
    );
    // Cerrar con Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") cerrar();
    });
    // Cerrar si se agranda a desktop
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1200) cerrar();
    });
  }

  // Mega-menú de Servicios: en mobile el icono abre/cierra (acordeón); en desktop abre por hover/foco (CSS).
  const navSvc = document.querySelector<HTMLElement>("[data-nav-svc]");
  const svcIcon = navSvc?.querySelector<HTMLButtonElement>("[data-svc-icon]");
  if (navSvc && svcIcon) {
    const sync = (abierto: boolean) => svcIcon.setAttribute("aria-expanded", String(abierto));
    const abiertoPorClase = () => navSvc.classList.contains("is-open");
    // Mobile: click en el icono togglea el submenú
    svcIcon.addEventListener("click", () => sync(navSvc.classList.toggle("is-open")));
    // Desktop: reflejar el estado hover/foco en aria-expanded
    navSvc.addEventListener("mouseenter", () => sync(true));
    navSvc.addEventListener("mouseleave", () => { if (!abiertoPorClase()) sync(false); });
    navSvc.addEventListener("focusin", () => sync(true));
    navSvc.addEventListener("focusout", () => {
      if (!navSvc.contains(document.activeElement) && !abiertoPorClase()) sync(false);
    });
    // Al pasar a desktop, resetear el acordeón mobile
    window.addEventListener("resize", () => {
      if (window.innerWidth > 1200) { navSvc.classList.remove("is-open"); sync(false); }
    });
  }

  // Dropdown de idioma (click para abrir; hover/focus también vía CSS).
  const menuLang = document.querySelector<HTMLElement>("[data-lang]");
  const btnLang = menuLang?.querySelector<HTMLButtonElement>("[data-lang-toggle]");
  if (menuLang && btnLang) {
    const cerrarLang = () => {
      menuLang.classList.remove("is-open");
      btnLang.setAttribute("aria-expanded", "false");
    };
    btnLang.addEventListener("click", (e) => {
      e.stopPropagation();
      const abierto = menuLang.classList.toggle("is-open");
      btnLang.setAttribute("aria-expanded", String(abierto));
    });
    document.addEventListener("click", (e) => {
      if (!menuLang.contains(e.target as Node)) cerrarLang();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") cerrarLang();
    });
  }
</script>
