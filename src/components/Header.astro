---
import Cta from "./Cta.astro";
import { navPrincipal, ctaPrincipal } from "../data/site";
---

<header class="cabecera" data-cabecera>
  <a class="cabecera__logo" href="/" aria-label="Teamcubation — inicio">
    <img
      src="/brand/logo-horizontal-color.svg"
      alt="Teamcubation"
      width="173"
      height="38"
      decoding="async"
    />
  </a>

  <nav class="cabecera__nav" aria-label="Navegación principal">
    {navPrincipal.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <Cta href={ctaPrincipal.href} label={ctaPrincipal.label} tamano="sm" class="cabecera__cta" />
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 20px 64px;
  }
  .cabecera__logo {
    flex: none;
    display: block;
  }
  .cabecera__logo img {
    height: 38px;
    width: auto;
    display: block;
  }
  .cabecera__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
  }
  .cabecera__nav a {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 20px;
    color: var(--color-tinta);
    text-decoration: none;
  }
  .cabecera__cta {
    flex: none;
  }

  /* ≤1100px: la nav pasa a una segunda fila (sin hamburguesa, como el diseño). */
  @media (max-width: 1100px) {
    .cabecera {
      flex-wrap: wrap;
      row-gap: 14px;
      column-gap: 24px;
      padding-left: 40px;
      padding-right: 40px;
    }
    .cabecera__nav {
      order: 3;
      flex: 1 1 100%;
      justify-content: flex-start;
      column-gap: 22px;
      row-gap: 8px;
    }
  }
  @media (max-width: 720px) {
    .cabecera {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
  @media (max-width: 480px) {
    .cabecera {
      padding-top: 16px;
      padding-bottom: 16px;
      row-gap: 12px;
    }
    .cabecera__nav {
      column-gap: 16px;
    }
    .cabecera__logo img {
      height: 28px;
    }
  }
</style>
