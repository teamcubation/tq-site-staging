---
// Tarjeta editorial — fondo gris-claro (o blanco/lima), radio 14, sin sombra.
interface Props {
  titulo?: string;
  variante?: "gris" | "blanco" | "lima";
  class?: string;
}
const { titulo, variante = "gris", class: clase = "" } = Astro.props;
---

<article class:list={["tarjeta", `tarjeta--${variante}`, clase]}>
  {titulo && <h3 class="tarjeta__titulo">{titulo}</h3>}
  <div class="tarjeta__cuerpo"><slot /></div>
</article>

<style>
  .tarjeta {
    border-radius: var(--radius-tarjeta);
    padding: 24px;
  }
  .tarjeta--gris { background: var(--color-gris-claro); }
  .tarjeta--blanco {
    background: var(--color-blanco);
    border: 1px solid var(--color-linea);
  }
  .tarjeta--lima { background: var(--color-lima); }
  .tarjeta__titulo {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 22px;
    color: var(--color-coral);
  }
  .tarjeta--lima .tarjeta__titulo { color: var(--color-tinta); }
  .tarjeta__cuerpo {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 18px;
    line-height: 1.5;
  }
  .tarjeta__titulo + .tarjeta__cuerpo { margin-top: 12px; }
</style>
