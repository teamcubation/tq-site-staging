---
// Círculo-check coral — la única "viñeta/ícono" de marca (SVG inline).
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: clase = "" } = Astro.props;
---

<span class:list={["circulo-check", clase]} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={size} height={size} role="presentation">
    <circle cx="12" cy="12" r="12" fill="var(--color-coral)"></circle>
    <path
      d="M7 12.5l3 3 7-7.5"
      fill="none"
      stroke="#fff"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
</span>

<style>
  .circulo-check {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }
</style>
