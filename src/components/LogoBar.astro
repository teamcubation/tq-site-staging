---
import Container from './Container.astro'

interface Props {
  label?: string
}

const { label = 'Empresas en las que desarrollamos experiencia' } = Astro.props

// TODO: replace with actual logo images
const logos = [
  { name: 'HP', src: '/logos/hp.svg' },
  { name: 'Macro', src: '/logos/macro.svg' },
  { name: 'Agro', src: '/logos/agro.svg' },
  { name: 'TCA', src: '/logos/tca.svg' },
  { name: 'Cencosud', src: '/logos/cencosud.svg' },
  { name: 'Appa', src: '/logos/appa.svg' },
  { name: 'Visa', src: '/logos/visa.svg' },
  { name: 'Paganini', src: '/logos/paganini.svg' },
  { name: 'Nulinga', src: '/logos/nulinga.svg' },
  { name: 'Nalgon', src: '/logos/nalgon.svg' },
]
---

<section class="border-b border-gray-200 py-8">
  <Container class="!max-w-[1240px] !px-5">
    <p class="mb-6 text-center text-sm text-[#5f5e5e]">{label}</p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {logos.map(({ name, src }) => (
        <img
          src={src}
          alt={name}
          class="h-6 w-auto grayscale opacity-60 md:h-8"
          loading="lazy"
        />
      ))}
    </div>
  </Container>
</section>
