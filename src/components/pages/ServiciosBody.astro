---
import HeroInterior from "../HeroInterior.astro";
import CierreCoral from "../CierreCoral.astro";
import escenaHero from "../../assets/ilustraciones/escena-hero-anillo-salto.png";
import { serviciosContent } from "../../content/servicios";
import { servicios } from "../../data/servicios";
import { ruta, rutaPrograma } from "../../i18n/routes";
import { defaultLocale, type Locale } from "../../i18n/config";

interface Props { lang?: Locale }
const { lang = defaultLocale } = Astro.props;
const c = serviciosContent[lang];
---

<main id="contenido">
  <HeroInterior
    kicker={c.hero.kicker}
    titulo={c.hero.tituloHtml}
    bajada={c.hero.bajada}
    imagen={escenaHero}
    imagenAlt={c.hero.imgAlt}
    cols="1.15fr 0.85fr"
    maxImg={400}
    padBottom={64}
    lang={lang}
  />

  <!-- ¿Qué podemos lograr juntos? — capas apiladas sticky (como el home) -->
  <section class="capas-svc">
    <div class="contenedor">
      <div class="capas-svc__head" data-capas-head>
        <h2 class="capas-svc__h2">{c.tituloCapas}</h2>
      </div>

      <div class="capas-svc__pila" data-capas-pila>
        {c.capas.map((capa, i) => (
          <article
            class:list={["capa-svc", i % 2 === 0 ? "capa-svc--gris" : "capa-svc--blanco"]}
            data-capa
            data-stack-i={i + 1}
          >
            <div class="capa-svc__inner">
              <h3 class="capa-svc__titulo">{capa.titulo}</h3>
              <p class="capa-svc__bajada">
                <strong class="capa-svc__etiqueta">{capa.etiqueta}</strong> {capa.bajada}
              </p>
              <div class:list={["scards", `scards--${Math.min(capa.keys.length, 3)}`]}>
                {capa.keys.map((k) => {
                  const s = c.items[k];
                  const href = rutaPrograma(servicios[k].slug, lang);
                  return (
                    <a class="scard" href={href}>
                      <p class="scard__necesita">{c.labels.necesita} {s.necesita}</p>
                      <h4 class="scard__titulo">{s.nombre}</h4>
                      <p class="scard__resumen">{s.resumen}</p>
                      <p class="scard__meta">
                        {c.labels.publico} {s.publico}<br />{c.labels.duracion} {s.duracion}<br />{c.labels.foco} {s.foco}
                      </p>
                    </a>
                  );
                })}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="primer-paso">
    <div class="contenedor">
      <h2 class="h2 mb28">{c.primerPaso.h2}</h2>
      <div class="dos-col">
        {c.primerPaso.cols.map((col) => (
          <div>
            <h3 class="h3">{col.h3}</h3>
            <p class="p" set:html={col.pHtml} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="panel-exp-sec">
    <div class="contenedor">
      <div class="panel-exp">
        <h2 class="h2 mb16">{c.panel.h2}</h2>
        <p class="p">{c.panel.p1}</p>
        <p class="p p--sm">{c.panel.p2}</p>
        <div class="panel-exp__links">
          {c.panel.links.map((l) => (
            <a class="enlace" href={ruta(l.routeKey, lang)}>{l.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CierreCoral lang={lang} />
</main>

<style>
  .h2 { font-size: 36px; line-height: 1.12; margin: 0; }
  .mb28 { margin-bottom: 28px; }
  .mb16 { margin-bottom: 16px; }
  .panel-exp .h2 { font-size: 32px; }
  .h3 { font-size: 24px; line-height: 1.15; margin: 0 0 8px; }
  .p { font-family: var(--font-body); font-weight: var(--peso-cuerpo); font-size: var(--fs-cuerpo); line-height: 1.5; max-width: 62ch; margin: 0; }

  .capas-svc { padding-block: 24px 88px; }
  .capas-svc__head { position: sticky; top: 78px; z-index: 5; background: #fff; padding: 12px 0 20px; }
  .capas-svc__h2 { font-size: 36px; line-height: 1.12; margin: 0; }
  .capas-svc__pila { display: flex; flex-direction: column; gap: 56px; padding: 32px 0 64px; }

  .capa-svc { position: sticky; border: 1px solid var(--color-linea); border-radius: var(--radius-tarjeta); padding: 28px 40px; min-height: 520px; display: flex; flex-direction: column; justify-content: center; }
  .capa-svc--gris { background: var(--color-gris-claro); }
  .capa-svc--blanco { background: #fff; }
  .capa-svc[data-stack-i="1"] { top: 198px; z-index: 1; }
  .capa-svc[data-stack-i="2"] { top: 228px; z-index: 2; }
  .capa-svc[data-stack-i="3"] { top: 258px; z-index: 3; }
  .capa-svc__titulo { font-family: var(--font-display); font-weight: 600; font-size: 30px; line-height: 1.12; letter-spacing: -0.02em; max-width: 30ch; margin: 0 0 12px; }
  .capa-svc__bajada { font-family: var(--font-body); font-weight: var(--peso-cuerpo); font-size: 14px; line-height: 1.5; max-width: 68ch; margin: 0 0 24px; }
  .capa-svc__etiqueta { font-weight: var(--peso-cuerpo-bold); color: var(--color-coral); }

  .scards { display: grid; gap: 24px; align-items: stretch; }
  .scards--1 { grid-template-columns: minmax(0, 1fr); }
  .scards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .scards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .scard { display: flex; flex-direction: column; gap: 10px; height: 100%; border-radius: var(--radius-tarjeta); padding: 24px; color: var(--color-tinta); text-decoration: none; transition: background-color 160ms ease-out; }
  .capa-svc--gris .scard { background: #fff; }
  .capa-svc--blanco .scard { background: var(--color-gris-claro); }
  .scard:hover { background: var(--color-superficie-hover); }
  .scard__necesita { font-family: var(--font-body); font-weight: var(--peso-cuerpo-semibold); font-size: var(--fs-secundario); color: var(--color-gris-texto); margin: 0; }
  .scard__titulo { font-size: 22px; line-height: 1.12; color: var(--color-coral); margin: 0; }
  .scard__resumen { font-family: var(--font-body); font-weight: var(--peso-cuerpo); font-size: 14px; line-height: 1.5; margin: 0; }
  .scard__meta { margin: auto 0 0; padding-top: 12px; font-family: var(--font-body); font-weight: var(--peso-cuerpo); font-size: var(--fs-secundario); line-height: 1.5; }

  .primer-paso { padding-block: 0 96px; }
  .dos-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }

  .panel-exp-sec { padding-block: 0 112px; }
  .panel-exp { background: var(--color-gris-claro); border-radius: var(--radius-tarjeta); padding: 48px; }
  .panel-exp .p { max-width: 70ch; margin-bottom: 14px; }
  .panel-exp .p--sm { margin-bottom: 24px; }
  .panel-exp__links { display: flex; flex-wrap: wrap; gap: 20px; }

  @media (max-width: 1100px) {
    /* apilado OFF — estático, sin sticky (igual que el home) */
    .capas-svc { padding-block: 24px 64px; }
    .capas-svc__head { position: static; top: auto; padding-bottom: 8px; }
    .capas-svc__pila { gap: 24px; padding-bottom: 48px; height: auto; }
    .capa-svc { position: static; top: auto; padding: 32px; min-height: 0; }
    .scards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .dos-col { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 720px) {
    .capa-svc { padding: 24px; }
    .scards--2, .scards--3 { grid-template-columns: 1fr; }
    .panel-exp { padding: 32px 24px; }
    .primer-paso { padding-bottom: 56px; }
    .panel-exp-sec { padding-bottom: 56px; }
  }
</style>

<script>
  // Apilado de las 3 capas (mismo mecanismo que el home CapasApiladas): sticky
  // con salida conjunta y fallback estático <1100px / reduced-motion / no cabe.
  const head = document.querySelector<HTMLElement>("[data-capas-head]");
  const pila = document.querySelector<HTMLElement>("[data-capas-pila]");
  const capas = Array.from(document.querySelectorAll<HTMLElement>("[data-capa]"));

  if (head && pila && capas.length === 3) {
    const topes = [198, 228, 258];
    let pilaH = 0;

    const estatico = () => {
      if (window.matchMedia("(max-width:1100px)").matches) return true;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return true;
      const alta = Math.max(...capas.map((c) => c.offsetHeight));
      return window.innerHeight < alta + 300;
    };

    const limpiar = () => {
      head.style.transform = "";
      pila.style.height = "";
      capas.forEach((c) => {
        c.style.position = "";
        c.style.top = "";
        c.style.left = "";
        c.style.width = "";
      });
    };

    const igualar = () => {
      capas.forEach((c) => (c.style.minHeight = ""));
      if (estatico()) return;
      const max = Math.max(...capas.map((c) => c.offsetHeight));
      capas.forEach((c) => (c.style.minHeight = max + "px"));
      pilaH = pila.offsetHeight;
    };

    const soltar = () => {
      capas.forEach((c, i) => {
        c.style.position = "sticky";
        c.style.top = topes[i] + "px";
        c.style.left = "";
        c.style.width = "";
      });
      head.style.transform = "";
      pila.style.height = "";
    };

    const onScroll = () => {
      if (estatico()) {
        limpiar();
        return;
      }
      const rp = pila.getBoundingClientRect();
      const cs = getComputedStyle(pila);
      const padB = parseFloat(cs.paddingBottom) || 0;
      const padL = parseFloat(cs.paddingLeft) || 0;
      const padR = parseFloat(cs.paddingRight) || 0;
      const ultima = capas[2];
      const estaticoTop = rp.bottom - padB - ultima.offsetHeight;
      const dist = estaticoTop - topes[2];

      if (dist > 0) {
        soltar();
        pilaH = pila.offsetHeight;
      } else {
        const delta = -dist;
        pila.style.height = pilaH + "px";
        const left = rp.left + padL;
        const width = pila.clientWidth - padL - padR;
        capas.forEach((c, i) => {
          c.style.position = "fixed";
          c.style.top = topes[i] - delta + "px";
          c.style.left = left + "px";
          c.style.width = width + "px";
        });
        const shift = Math.min(Math.max(0, -dist), head.offsetHeight);
        head.style.transform = `translateY(${-shift}px)`;
      }
    };

    const onResize = () => {
      limpiar();
      igualar();
      onScroll();
    };

    igualar();
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("load", onResize);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(onResize);
    requestAnimationFrame(onResize);
  }
</script>
