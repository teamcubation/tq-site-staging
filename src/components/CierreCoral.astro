---
// Cierre coral — banda de sección coral con isotipo blanco, título y CTA.
// Presente al final de casi todas las páginas.
import Cta from "./Cta.astro";

interface Props {
  titulo: string;
  texto?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const { titulo, texto, ctaLabel, ctaHref } = Astro.props;
---

<section class="cierre">
  <div class="cierre__contenido">
    <img
      src="/brand/isotipo-blanco.svg"
      alt=""
      width="31"
      height="24"
      class="cierre__iso"
      aria-hidden="true"
      decoding="async"
    />
    <h2 class="cierre__titulo">{titulo}</h2>
    {texto && <p class="cierre__texto">{texto}</p>}
    <div class="cierre__cta">
      <Cta tamano="lg" label={ctaLabel} href={ctaHref} />
    </div>
  </div>
</section>

<style>
  .cierre {
    background: var(--color-coral);
    color: #fff;
    padding: 96px 64px;
    text-align: center;
  }
  .cierre__contenido {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cierre__iso {
    height: 24px;
    width: auto;
    margin-bottom: 24px;
  }
  .cierre__titulo {
    color: #fff;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.1;
  }
  .cierre__texto {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.5;
    margin: 16px 0 0;
  }
  .cierre__cta { margin-top: 32px; }

  @media (max-width: 720px) {
    .cierre { padding: 64px 24px; }
  }
</style>
