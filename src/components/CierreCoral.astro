---
// Cierre coral — banda de sección coral con isotipo blanco, título y CTA.
// Presente al final de casi todas las páginas.
import Cta from "./Cta.astro";
import { ui } from "../i18n/ui";
import { defaultLocale, type Locale } from "../i18n/config";

interface Props {
  // El título es fijo (tagline de marca «Data Driven On-the-job Tech Training»);
  // el prop se mantiene por compatibilidad con los llamados existentes.
  titulo?: string;
  texto?: string;
  ctaLabel?: string;
  ctaHref?: string;
  grande?: boolean; // Home y Metodología usan 48px; el resto 44px (default).
  enlaceExtra?: { label: string; href: string };
  lang?: Locale;
}
const { ctaLabel, ctaHref, grande = false, enlaceExtra, lang = defaultLocale } = Astro.props;
const texto = Astro.props.texto ?? ui[lang].cierreTexto;
---

<section class:list={["cierre", grande && "cierre--grande"]}>
  <div class="cierre__contenido">
    <img
      src="/brand/isotipo-blanco.svg"
      alt=""
      width="31"
      height="24"
      class="cierre__iso"
      aria-hidden="true"
      decoding="async"
    />
    <h2 class="cierre__titulo">Data Driven On-the-job<br />Tech Training</h2>
    {texto && <p class="cierre__texto">{texto}</p>}
    <div class="cierre__cta">
      <Cta tamano="lg" label={ctaLabel} href={ctaHref} lang={lang} />
      {enlaceExtra && (
        <a class="cierre__enlace" href={enlaceExtra.href} target="_blank" rel="noreferrer">
          {enlaceExtra.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cierre {
    background: var(--color-coral);
    color: #fff;
    padding: 48px 64px;
    text-align: center;
  }
  .cierre__contenido {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cierre__iso {
    height: 24px;
    width: auto;
    margin-bottom: 16px;
  }
  .cierre__titulo {
    color: #fff;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.1;
  }
  .cierre--grande .cierre__titulo {
    font-size: clamp(30px, 3.6vw, 48px);
  }
  .cierre__texto {
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo-semibold);
    font-size: var(--fs-cuerpo);
    line-height: 1.5;
    margin: 16px 0 0;
  }
  .cierre__cta {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }
  .cierre__enlace {
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 19px;
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .cierre { padding: 48px 24px; }
    .cierre__cta :global(.cta-capsula) { font-size: 19px; }
  }
</style>
