---
import Container from './Container.astro'

interface Props {
  title?: string
  highlightText?: string
  subtitle?: string
  ctaPrimaryLabel?: string
  ctaPrimaryHref?: string
  ctaSecondaryLabel?: string
  ctaSecondaryHref?: string
}

const {
  title = 'Desarrolladores',
  highlightText = 'de Experiencia',
  subtitle = 'Tus colaboradores desarrollan habilidades tecnológicas con acompañamiento experto y entrenamientos on the job.',
  ctaPrimaryLabel = 'Servicios',
  ctaPrimaryHref = '#servicios',
  ctaSecondaryLabel = 'Casos de Éxito',
  ctaSecondaryHref = '#casos-de-exito',
} = Astro.props
---

<section class="overflow-hidden py-12 lg:py-20">
  <Container class="!max-w-[1240px] !px-5">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-start lg:justify-between">
      <!-- Left content -->
      <div class="max-w-lg">
        <h1 class="font-extrabold leading-[1.1] text-[#1d1b1b]">
          <span class="block text-4xl md:text-5xl lg:text-[56px]">{title}</span>
          <span class="block bg-gradient-to-r from-[#ff4933] to-[#ff8a6b] bg-clip-text text-4xl text-transparent md:text-5xl lg:text-[56px]">
            {highlightText}
          </span>
        </h1>

        <p class="mt-6 text-base leading-relaxed text-[#5f5e5e] md:text-lg">
          {subtitle}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={ctaPrimaryHref}
            class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-white transition hover:bg-[#e63e2a]"
          >
            {ctaPrimaryLabel}
          </a>
          <a
            href={ctaSecondaryHref}
            class="rounded-full border border-[#1d1b1b] px-6 py-3 text-sm font-bold text-[#1d1b1b] transition hover:bg-[#1d1b1b] hover:text-white"
          >
            {ctaSecondaryLabel}
          </a>
        </div>
      </div>

      <!-- Right illustration -->
      <div class="relative hidden w-full max-w-md lg:block">
        <!-- TODO: replace with actual hero illustration/avatars -->
        <div class="aspect-square w-full rounded-full bg-gray-100"></div>
      </div>
    </div>
  </Container>
</section>
