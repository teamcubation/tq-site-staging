---
// Tira de logos de clientes — marquee lineal 60s, con control «Pausar logos» y
// respeto por reduced-motion. Muestra los clientes marcados para la home, en el orden de la
// lista (src/data/clientes.json).
import { Image } from "astro:assets";
import { clientesHome } from "../../data/clientes";

// Cada logo ocupa más o menos la misma superficie, hasta 150 × 44 px: los anchos quedan más
// bajos y los cuadrados más altos, y la tira se ve pareja.
const SUPERFICIE = 3000;
const logos = clientesHome.map((c) => {
  const proporcion = c.logo.width / c.logo.height;
  const alto = Math.min(44, Math.sqrt(SUPERFICIE / proporcion), 150 / proporcion);
  return { img: c.logo, nombre: c.nombre, ancho: Math.round(alto * proporcion), alto: Math.round(alto) };
});
---

<div class="tira" data-tira-wrap>
  <div class="tira__track" data-tira-track>
    <ul class="tira__grupo">
      {logos.map((l) => (
        <li class="tira__logo">
          <Image src={l.img} alt={l.nombre} width={l.ancho * 2} height={l.alto * 2} style={`width: ${l.ancho}px; height: ${l.alto}px`} loading="lazy" />
        </li>
      ))}
    </ul>
    <ul class="tira__grupo" aria-hidden="true">
      {logos.map((l) => (
        <li class="tira__logo">
          <Image src={l.img} alt="" width={l.ancho * 2} height={l.alto * 2} style={`width: ${l.ancho}px; height: ${l.alto}px`} loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .tira {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 24px 0;
  }
  .tira__track {
    display: flex;
    width: max-content;
    animation: tc-tira 60s linear infinite;
  }
  .tira__track.paused { animation-play-state: paused; }
  .tira__grupo {
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 0 64px 0 0;
    margin: 0;
    list-style: none;
  }
  .tira__logo {
    flex: none;
    width: 150px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tira__logo :global(img) {
    display: block;
    object-fit: contain;
  }
  @keyframes tc-tira {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tira__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      gap: 32px 48px;
    }
    .tira__grupo[aria-hidden="true"] { display: none; }
  }

  /* Pausa al interactuar (sin botón visible) — accesibilidad del marquee. */
  .tira:hover .tira__track,
  .tira:focus-within .tira__track {
    animation-play-state: paused;
  }
</style>
