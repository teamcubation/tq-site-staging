---
// Hero de Home — video 3D scrubbeado por scroll (el scroll controla el frame).
// Fallback al poster en reduced-motion / si el video falla. Content-driven (ES default).
import Cta from "../Cta.astro";
import { defaultLocale, type Locale } from "../../i18n/config";

export interface HeroContent {
  eyebrow: string;
  tituloHtml: string; // permite <span class="resaltado">
  subhead: string;
  bajadaHtml: string; // permite <br> y <b>
}

interface Props {
  content?: HeroContent;
  lang?: Locale;
}

const esDefault: HeroContent = {
  eyebrow: "La inversión en IA necesita adopción.",
  tituloHtml:
    '¿Su compañía está aprovechando todo <span class="resaltado">el potencial de la IA?</span>',
  subhead: "Entrenamos a sus equipos para adoptar IA con impacto real en el negocio.",
  bajadaHtml:
    "A diferencia de un curso sus colaboradores aprenden, guiados por nuestros mentores expertos, trabajando en procesos y proyectos reales de su día a día.<br />Porque la experiencia no se enseña: <b>se entrena</b>.",
};

const { content = esDefault, lang = defaultLocale } = Astro.props;
---

<section class="hero" data-hero>
  <img class="hero__poster" src="/media/hero-poster.jpg" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
  <video
    class="hero__video"
    data-hero-video
    muted
    playsinline
    preload="auto"
    poster="/media/hero-poster.jpg"
    aria-hidden="true"
  >
    <source src="/media/scroll-hero.mp4" type="video/mp4" />
  </video>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__text">
    <p class="hero__eyebrow">{content.eyebrow}</p>
    <h1 class="hero__titulo" set:html={content.tituloHtml} />
    <p class="hero__subhead">{content.subhead}</p>
    <p class="hero__bajada" set:html={content.bajadaHtml} />
    <div class="hero__acciones">
      <Cta lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: calc(56.25vw - 75px);
    overflow: hidden;
    background: #fff;
  }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right top;
  }
  .hero__poster { z-index: 0; }
  .hero__video {
    z-index: 1;
    opacity: 0;
    transition: opacity 160ms linear;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #fff 0%,
      #fff 20%,
      rgba(255, 255, 255, 0.6) 28%,
      rgba(255, 255, 255, 0) 36%
    );
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0, 0, 0, 0) 54%);
    mask-image: linear-gradient(180deg, #000 0%, #000 38%, rgba(0, 0, 0, 0) 54%);
  }
  .hero__text {
    position: relative;
    z-index: 3;
    width: 54%;
    max-width: 780px;
    padding: clamp(48px, 7vh, 96px) clamp(24px, 3.6vw, 72px) clamp(56px, 8vh, 104px);
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(17px, 1.5vw, 25px);
    line-height: 1.2;
    color: var(--color-coral);
    margin: 0 0 10px;
  }
  .hero__titulo {
    font-size: clamp(22px, 3.2vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0;
  }
  /* En desktop, la frase resaltada del h1 no se parte de renglón y su
     fondo lima tiene un alto fijo de 69px (texto centrado). */
  @media (min-width: 1000px) {
    .hero__titulo :global(.resaltado) {
      white-space: nowrap;
      height: 69px;
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
  .hero__subhead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 28px);
    line-height: 1.25;
    max-width: 34ch;
    margin: 18px 0 0;
  }
  .hero__bajada {
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo);
    font-size: 14px;
    line-height: 1.2;
    max-width: 44ch;
    margin: 14px 0 0;
  }
  .hero__acciones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: clamp(24px, 3.4vh, 44px);
  }

  @media (max-width: 1200px) {
    .hero__text { width: 62%; }
    .hero__titulo { max-width: 23ch; }
  }
  @media (max-width: 1000px) {
    .hero {
      height: auto;
      min-height: max(138vw, 92svh);
      display: flex;
      align-items: flex-start;
    }
    .hero__poster,
    .hero__video {
      inset: auto 0 0 0;
      height: 82%;
      object-position: 8% center;
    }
    .hero__veil {
      background: linear-gradient(180deg, #fff 0%, #fff 30%, rgba(255, 255, 255, 0) 60%);
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hero__text {
      width: 100%;
      max-width: 100%;
      padding: clamp(32px, 5vh, 64px) 40px clamp(40px, 6vh, 72px);
    }
  }
  @media (max-width: 720px) {
    .hero__text { padding: clamp(32px, 5vh, 56px) 24px clamp(32px, 5vh, 56px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; min-height: 0; }
    .hero__video { display: none; }
  }
</style>

<script>
  // Hero video: en desktop se scrubbea por scroll; en mobile va autoplay
  // muteado en loop (el scrubbing es poco fiable en mobile, sobre todo iOS).
  const seccion = document.querySelector<HTMLElement>("[data-hero]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (seccion && !reduce) {
    const video = seccion.querySelector<HTMLVideoElement>("[data-hero-video]");
    if (video) {
      const mostrar = () => { video.style.opacity = "1"; };
      video.addEventListener("error", () => { video.style.display = "none"; });

      if (window.matchMedia("(max-width: 1000px)").matches) {
        // Mobile: ping-pong (adelante y atrás) moviendo currentTime, en vez de
        // loop nativo (que corta seco de fin a principio).
        video.muted = true;
        video.addEventListener("loadeddata", mostrar);
        let dir = 1;
        let prev = 0;
        let raf = 0;
        const paso = (t: number) => {
          if (!prev) prev = t;
          const dt = Math.min((t - prev) / 1000, 0.05);
          prev = t;
          const dur = video.duration || 5;
          let nt = video.currentTime + dir * dt;
          if (nt >= dur) { nt = dur; dir = -1; }
          else if (nt <= 0) { nt = 0; dir = 1; }
          try { video.currentTime = nt; } catch { /* seeking no disponible aún */ }
          raf = requestAnimationFrame(paso);
        };
        const iniciar = () => { prev = 0; cancelAnimationFrame(raf); raf = requestAnimationFrame(paso); mostrar(); };
        // Prime (habilita el seeking en iOS) y arranca el ping-pong.
        video.play().then(() => { video.pause(); iniciar(); }).catch(() => {
          window.addEventListener("pointerdown", () => {
            video.play().then(() => { video.pause(); iniciar(); }).catch(iniciar);
          }, { once: true, passive: true });
        });
      } else {
        // Desktop: scrubbing del video por scroll.
        let visible = false;
        let objetivo = 0;
        let actual = 0;
        let raf = 0;
        let listo = false;

        video.addEventListener("loadedmetadata", () => {
          if (video.duration > 0) {
            listo = true;
            mostrar();
          }
        });

        const calcular = () => {
          const r = seccion.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / r.height));
          objetivo = p * (video.duration || 0);
        };

        const tick = () => {
          actual += (objetivo - actual) * 0.12;
          if (Math.abs(objetivo - actual) < 0.001) actual = objetivo;
          if (listo) {
            try {
              video.currentTime = actual;
            } catch {
              /* seeking aún no disponible */
            }
          }
          if (visible) raf = requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((e) => {
              visible = e.isIntersecting;
              cancelAnimationFrame(raf);
              if (visible) {
                calcular();
                raf = requestAnimationFrame(tick);
              }
            });
          },
          { threshold: 0 }
        );
        io.observe(seccion);

        window.addEventListener("scroll", calcular, { passive: true });
        window.addEventListener("resize", calcular, { passive: true });

        const prime = () => {
          video.play().then(() => video.pause()).catch(() => {});
        };
        window.addEventListener("pointerdown", prime, { once: true, passive: true });
        window.addEventListener("wheel", prime, { once: true, passive: true });
      }
    }
  }
</script>
