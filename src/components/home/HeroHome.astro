---
// Hero de Home — secuencia de frames WebP scrubbeada por scroll (self-hosted).
// El scroll elige el frame, dibujado en un <canvas>. Sin video: adiós al
// seek de iOS / Range / blob. Fallback al poster en reduced-motion. ES default.
import Cta from "../Cta.astro";
import { defaultLocale, type Locale } from "../../i18n/config";

export interface HeroContent {
  eyebrow: string;
  tituloHtml: string; // permite <span class="resaltado">
  subhead: string;
  bajadaHtml: string; // permite <br> y <b>
}

interface Props {
  content?: HeroContent;
  lang?: Locale;
}

const esDefault: HeroContent = {
  eyebrow: "La inversión en IA necesita adopción.",
  tituloHtml:
    '¿Su compañía está aprovechando todo <span class="resaltado">el potencial de la IA?</span>',
  subhead: "Entrenamos a sus equipos para adoptar IA con impacto real en el negocio.",
  bajadaHtml:
    "A diferencia de un curso sus colaboradores aprenden, guiados por nuestros mentores expertos, trabajando en procesos y proyectos reales de su día a día.<br />Porque la experiencia no se enseña: <b>se entrena</b>.",
};

const { content = esDefault, lang = defaultLocale } = Astro.props;

// Secuencia de frames en /public/media/hero-frames/ (f_001.webp … f_120.webp):
// los 120 frames de hero-video.mp4, a 1920x1080 (WebP q88).
const FRAMES = 120;
---

<section class="hero" data-hero data-frames={FRAMES}>
  <img class="hero__poster" src="/media/hero-poster.jpg" alt="" aria-hidden="true" fetchpriority="high" decoding="async" />
  <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__text">
    <p class="hero__eyebrow">{content.eyebrow}</p>
    <h1 class="hero__titulo" set:html={content.tituloHtml} />
    <p class="hero__subhead">{content.subhead}</p>
    <p class="hero__bajada" set:html={content.bajadaHtml} />
    <div class="hero__acciones">
      <Cta lang={lang} />
    </div>
  </div>
</section>

<style>
  /* Alto: el del dibujo (16:9) menos 75px. Debajo de 1366px queda fijo en el
     de 1366px, igual que el ancho del dibujo: si achicara con la ventana, el
     dibujo se cortaría a media altura en vez de apoyar su base en el borde. */
  .hero {
    position: relative;
    height: calc(max(100vw, 1366px) * 0.5625 - 75px);
    overflow: hidden;
    background: #fff;
  }
  /* Debajo de 1366px el dibujo conserva ese ancho y se recorta a la derecha:
     si achicara con la ventana, su esfera y su pedestal pisarían el texto. */
  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: max(100%, 1366px);
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: right top;
  }
  .hero__poster { z-index: 0; }
  .hero__canvas {
    z-index: 1;
    opacity: 0;
    transition: opacity 160ms linear;
  }
  /* El velo blanco solo existe en el layout apilado (≤1000px). */
  .hero__veil { display: none; }
  .hero__text {
    position: relative;
    z-index: 3;
    width: 54%;
    max-width: 780px;
    padding: clamp(48px, 7vh, 96px) clamp(24px, 3.6vw, 72px) clamp(56px, 8vh, 104px);
  }
  .hero__eyebrow {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(17px, 1.5vw, 25px);
    line-height: 1.2;
    color: var(--color-coral);
    margin: 0 0 10px;
  }
  .hero__titulo {
    font-size: clamp(22px, 3.2vw, 58px);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: 0;
  }
  /* En desktop, la frase resaltada del h1 no se parte de renglón y su
     fondo lima tiene un alto fijo de 69px (texto centrado). Alineada por
     baseline (la caja toma la de su texto): con "middle" la frase quedaba
     unos px más abajo que el resto del renglón ("all" en EN). */
  @media (min-width: 1000px) {
    .hero__titulo :global(.resaltado) {
      white-space: nowrap;
      height: 69px;
      display: inline-flex;
      align-items: center;
      vertical-align: baseline;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
  .hero__subhead {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 1.7vw, 28px);
    line-height: 1.25;
    max-width: 34ch;
    margin: 18px 0 0;
  }
  .hero__bajada {
    font-family: var(--font-body);
    font-weight: var(--peso-cuerpo);
    font-size: 15px;
    line-height: 1.2;
    max-width: 42ch;
    margin: 14px 0 0;
  }
  .hero__acciones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: clamp(24px, 3.4vh, 44px);
  }

  @media (max-width: 1200px) {
    .hero__text { width: 62%; }
    .hero__titulo { max-width: 23ch; }
  }
  @media (max-width: 1000px) {
    .hero {
      height: auto;
      min-height: max(138vw, 92svh);
      display: flex;
      align-items: flex-start;
    }
    .hero__poster,
    .hero__canvas {
      inset: auto 0 0 0;
      width: 100%;
      height: 82%;
      object-position: 8% center;
    }
    /* El dibujo arranca más abajo y su fondo no es blanco puro: el velo funde
       su borde superior para que no se vea una línea detrás del texto. */
    .hero__veil {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(180deg, #fff 0%, #fff 46%, rgba(255, 255, 255, 0) 62%);
    }
    .hero__text {
      width: 100%;
      max-width: 100%;
      padding: clamp(32px, 5vh, 64px) 40px clamp(40px, 6vh, 72px);
    }
  }
  @media (max-width: 720px) {
    .hero__text { padding: clamp(32px, 5vh, 56px) 24px clamp(32px, 5vh, 56px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { height: auto; min-height: 0; }
    .hero__canvas { display: none; }
  }
</style>

<script>
  // Hero: scrub por scroll de una secuencia de frames WebP precargados,
  // dibujados en un <canvas> con drawImage (sincrónico → sin flicker/tembleques).
  const seccion = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = seccion?.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (seccion && canvas && !reduce) {
    const ctx = canvas.getContext("2d");
    const total = Number(seccion.dataset.frames || 0);

    if (ctx && total > 0) {
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";

      const url = (i: number) =>
        `/media/hero-frames/f_${String(i + 1).padStart(3, "0")}.webp`;

      const imgs: HTMLImageElement[] = [];
      const cargado: boolean[] = new Array(total).fill(false);
      let dibujado = -1;

      // Dibuja el frame idx cubriendo el canvas (cover + object-position del CSS).
      const dibujar = (idx: number) => {
        const im = imgs[idx];
        if (!im || !cargado[idx]) return;
        const W = canvas.width;
        const H = canvas.height;
        const s = Math.max(W / im.naturalWidth, H / im.naturalHeight);
        const w = im.naturalWidth * s;
        const h = im.naturalHeight * s;
        const movil = window.matchMedia("(max-width:1000px)").matches;
        const px = movil ? 0.08 : 1; // X: desktop derecha, móvil 8%
        const py = movil ? 0.5 : 0; // Y: desktop arriba, móvil centro
        ctx.clearRect(0, 0, W, H);
        ctx.drawImage(im, (W - w) * px, (H - h) * py, w, h);
        dibujado = idx;
      };

      // Ajusta el backing-store del canvas al tamaño real (× DPR) y redibuja.
      const redimensionar = () => {
        const r = canvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.max(1, Math.round(r.width * dpr));
        canvas.height = Math.max(1, Math.round(r.height * dpr));
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = "high";
        if (dibujado >= 0) {
          const d = dibujado;
          dibujado = -1;
          dibujar(d);
        }
      };

      for (let i = 0; i < total; i++) {
        const im = new Image();
        im.decoding = "async";
        im.onload = () => {
          cargado[i] = true;
          if (i === 0) {
            redimensionar();
            dibujar(0);
            canvas.style.opacity = "1";
          }
        };
        im.src = url(i);
        imgs.push(im);
      }

      // Frame cargado más cercano al objetivo (evita huecos mientras precarga).
      const masCercano = (idx: number) => {
        for (let j = idx; j >= 0; j--) if (cargado[j]) return j;
        for (let j = idx + 1; j < total; j++) if (cargado[j]) return j;
        return -1;
      };

      let visible = false;
      let objetivo = 0;
      let actual = 0;
      let raf = 0;

      const calcular = () => {
        const r = seccion.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / r.height));
        objetivo = p * (total - 1);
      };

      const tick = () => {
        actual += (objetivo - actual) * 0.15;
        if (Math.abs(objetivo - actual) < 0.01) actual = objetivo;
        const idx = masCercano(Math.round(actual));
        if (idx !== -1 && idx !== dibujado) dibujar(idx);
        if (visible) raf = requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((e) => {
            visible = e.isIntersecting;
            cancelAnimationFrame(raf);
            if (visible) {
              calcular();
              raf = requestAnimationFrame(tick);
            }
          });
        },
        { threshold: 0 }
      );
      io.observe(seccion);

      window.addEventListener("scroll", calcular, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          redimensionar();
          calcular();
        },
        { passive: true }
      );
    }
  }
</script>
